{
  "name": "yichang-travel-mini-program",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs --mode=demo",
    "build:demo": "node scripts/build.mjs --mode=demo",
    "build:dev": "node scripts/build.mjs --mode=development",
    "check:package": "node scripts/check-package.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "test:integration": "node scripts/platform-gate.mjs integration",
    "test:e2e": "node scripts/wechat-smoke.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "import:content": "node scripts/import-content.mjs",
    "plan:security-rules": "node scripts/plan-security-rules.mjs",
    "release:check": "node scripts/platform-gate.mjs release"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.0.18",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "miniprogram-api-typings": "5.2.3",
    "miniprogram-automator": "0.12.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.0.18"
  }
}
