{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings", "node", "vitest/globals"]
  },
  "include": ["miniprogram/**/*.ts", "shared/**/*.ts", "cloudfunctions/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
