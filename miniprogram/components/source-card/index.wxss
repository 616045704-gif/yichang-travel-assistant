.source-card { display: flex; flex-direction: column; gap: 8rpx; padding: 22rpx; border: 1rpx solid var(--color-border); border-radius: 22rpx; background: var(--color-page); }.source-title { margin-top: 4rpx; color: var(--color-brand-deep); font-size: 23rpx; font-weight: 700; }.source-text { color: var(--color-muted); font-size: 23rpx; line-height: 1.65; white-space: pre-wrap; overflow-wrap: break-word; }
