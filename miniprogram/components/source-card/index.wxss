.source-card { display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx 22rpx; border: 1rpx solid #dfd2b8; border-radius: 20rpx; background: #f4ecdc; }.source-title { margin-top: 4rpx; color: var(--color-gold-dark); font-size: 23rpx; font-weight: 600; }.source-text { color: var(--color-muted); font-size: 23rpx; line-height: 1.7; white-space: pre-wrap; overflow-wrap: break-word; }
