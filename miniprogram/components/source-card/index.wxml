<view wx:if="{{facts.length || references.length}}" class="source-card"><text wx:if="{{facts.length}}" class="source-title">本地资料参考</text><text wx:for="{{facts}}" wx:key="*this" class="source-text">{{item}}</text><text wx:if="{{references.length}}" class="source-title">参考资料</text><text wx:for="{{references}}" wx:key="title" class="source-text">{{item.title}}{{item.verifiedAt ? ' · ' + item.verifiedAt : ''}}</text></view>
