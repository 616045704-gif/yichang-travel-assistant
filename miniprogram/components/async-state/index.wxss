.state { padding: 56rpx 32rpx; text-align: center; }.state-icon { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 84rpx; height: 84rpx; margin: 0 auto 20rpx; border-radius: 28rpx; background: var(--color-action-soft); }.state-title { display: block; color: var(--color-brand-deep); font-size: 30rpx; font-weight: 700; }.state-message { display: block; max-width: 520rpx; margin: 12rpx auto 0; color: var(--color-muted); font-size: 24rpx; line-height: 1.65; overflow-wrap: break-word; }.retry { display: inline-block; min-height: 88rpx; margin-top: 28rpx; padding: 20rpx 48rpx; background: var(--color-action); color: var(--color-brand-deep); font-size: 26rpx; font-weight: 700; line-height: 1.5; border-radius: 999rpx; }.retry::after { border: 0; }.spinner { width: 60rpx; height: 60rpx; margin-bottom: 30rpx; border: 6rpx solid #ddd5ff; border-top-color: var(--color-brand); background: transparent; border-radius: 50%; animation: spin 1s linear infinite; }.spinner-dot { position: absolute; top: -8rpx; right: 2rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--color-action); }.empty-mark { width: 38rpx; height: 28rpx; border: 6rpx solid var(--color-brand); border-radius: 8rpx 8rpx 16rpx 16rpx; }.error-icon { background: #ffe2e7; }.error-mark { position: relative; width: 8rpx; height: 34rpx; border-radius: 8rpx; background: var(--color-danger); }.error-mark::after { position: absolute; left: 0; bottom: -14rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--color-danger); content: ''; }@keyframes spin { to { transform: rotate(360deg); } }
