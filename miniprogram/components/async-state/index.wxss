.state { padding: 48rpx 32rpx; text-align: center; }.state-icon { margin: 0 auto 20rpx; width: 76rpx; height: 76rpx; line-height: 76rpx; border-radius: 50%; background: #ecf0e6; color: #7e987c; font-size: 48rpx; box-sizing: border-box; }.state-title { display: block; color: #3d5546; font-size: 28rpx; font-weight: 550; }.state-message { display: block; margin: 12rpx auto 0; color: #788477; font-size: 24rpx; line-height: 1.8; overflow-wrap: break-word; max-width: 520rpx; }.retry { display: inline-block; min-height: 88rpx; margin-top: 28rpx; padding: 22rpx 48rpx; line-height: 1.5; font-size: 26rpx; background: #176b5b; color: #fffefa; border-radius: 32rpx; }.retry::after { border: 0; }.error-icon { color: #96723c; background: #f2eadb; }.spinner { width: 54rpx; height: 54rpx; margin-bottom: 30rpx; border: 4rpx solid #e2e7da; border-top-color: #176b5b; background: transparent; animation: spin 1s linear infinite; }@keyframes spin { to { transform: rotate(360deg); } }
