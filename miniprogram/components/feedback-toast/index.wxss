.feedback-toast { position: fixed; z-index: 99; top: 28rpx; left: 32rpx; right: 32rpx; display: flex; align-items: center; gap: 16rpx; min-height: 96rpx; padding: 20rpx 20rpx 20rpx 24rpx; border: 1rpx solid var(--color-border); border-radius: 24rpx; background: #fff; box-shadow: 0 16rpx 38rpx rgba(43, 23, 77, .18); color: var(--color-brand-deep); }
.feedback-mark { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: var(--color-action); }
.feedback-mark-core { width: 14rpx; height: 14rpx; border: 4rpx solid var(--color-brand-deep); border-radius: 50%; }
.feedback-message { flex: 1; min-width: 0; font-size: 25rpx; font-weight: 650; line-height: 1.45; overflow-wrap: break-word; }
.feedback-close { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; padding: 0; border-radius: 50%; background: var(--color-page); }
.feedback-close-mark { position: relative; width: 20rpx; height: 20rpx; }.feedback-close-mark::before, .feedback-close-mark::after { position: absolute; top: 8rpx; left: 0; width: 20rpx; height: 3rpx; border-radius: 3rpx; background: var(--color-brand-deep); content: ''; transform: rotate(45deg); }.feedback-close-mark::after { transform: rotate(-45deg); }
.feedback-success .feedback-mark { background: #c7f2df; }.feedback-success .feedback-mark-core { border-color: var(--color-success); border-width: 0 4rpx 4rpx 0; border-radius: 0; transform: rotate(45deg) translate(-2rpx, -2rpx); }.feedback-error .feedback-mark { background: #ffe2e7; }.feedback-error .feedback-mark-core { border-color: var(--color-danger); }
