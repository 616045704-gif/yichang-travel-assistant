.bubble { display: flex; flex-direction: column; gap: 10rpx; max-width: 88%; padding: 22rpx 24rpx; border-radius: 24rpx; box-shadow: 0 6rpx 18rpx rgba(70, 43, 139, .08); }.bubble-user { align-self: flex-end; margin-left: auto; background: var(--color-brand-deep); color: #fff; border-bottom-right-radius: 8rpx; }.bubble-assistant { align-self: flex-start; margin-right: auto; border: 1rpx solid var(--color-border); background: #fff; color: var(--color-text); border-bottom-left-radius: 8rpx; }.bubble-text { line-height: 1.75; white-space: pre-wrap; overflow-wrap: break-word; }.mock-label { color: var(--color-brand); font-size: 21rpx; font-weight: 700; }.bubble-user .mock-label { color: var(--color-action); }
