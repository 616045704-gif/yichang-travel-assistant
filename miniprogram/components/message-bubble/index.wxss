.bubble { display: flex; flex-direction: column; gap: 10rpx; max-width: 88%; padding: 22rpx 24rpx; border-radius: 24rpx; }.bubble-user { align-self: flex-end; margin-left: auto; background: #627968; color: #fffefa; border-bottom-right-radius: 6rpx; }.bubble-assistant { align-self: flex-start; margin-right: auto; background: #fcf8ef; color: var(--color-text); border: 1rpx solid var(--color-border); border-bottom-left-radius: 6rpx; }.bubble-text { line-height: 1.8; white-space: pre-wrap; overflow-wrap: break-word; }.mock-label { color: #886b3d; font-size: 21rpx; font-weight: 600; }.bubble-user .mock-label { color: #fff3d5; }
