.filters { display: flex; flex-wrap: wrap; gap: 12rpx; }.filter { pointer-events: auto; width: auto; flex: 0 0 auto; max-width: 100%; min-height: 76rpx; margin: 0; padding: 14rpx 24rpx; border: 1rpx solid var(--color-border); border-radius: 999rpx; background: #fff; color: var(--color-brand-deep); font-size: 25rpx; font-weight: 650; line-height: 1.65; box-shadow: 0 6rpx 16rpx rgba(70, 43, 139, .08); }.filter::after { border: 0; }.selected { border-color: var(--color-brand); background: var(--color-brand); color: #fff; }
