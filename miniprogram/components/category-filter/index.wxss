.category-tabs { display: block; box-sizing: border-box; width: 100%; padding: 0; overflow: hidden; pointer-events: auto; }
.category-tabs-track { display: flex; align-items: stretch; width: 100%; min-width: 0; gap: 8rpx; }
.category-tab { display: inline-flex; box-sizing: border-box; flex: 1 1 0; flex-direction: column; align-items: center; justify-content: center; min-width: 0; width: auto; height: 112rpx; margin: 0; padding: 8rpx 4rpx 7rpx; border: 1rpx solid rgba(116, 84, 216, .10); border-radius: 24rpx; background: rgba(255, 255, 255, .98); box-shadow: 0 8rpx 22rpx rgba(53, 39, 92, .06); line-height: normal; }
.category-tab::after { border: 0; }
.category-tab.category-tab-pressed { opacity: .82; transform: scale(.97); }
.category-tab.is-active { border-color: #d9ceff; background: #f0ecff; box-shadow: 0 8rpx 24rpx rgba(116, 84, 216, .10); }
.category-tab-icon { display: block; flex: 0 0 auto; width: 56rpx; height: 56rpx; }
.category-tab-label { display: block; max-width: 100%; margin-top: 0; color: var(--color-text-strong); font-size: 20rpx; font-weight: 700; line-height: 1; text-align: center; white-space: normal; }
.category-tab.is-active .category-tab-label { color: var(--color-brand); }
