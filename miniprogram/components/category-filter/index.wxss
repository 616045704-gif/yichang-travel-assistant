.filters { display: flex; flex-wrap: wrap; gap: 12rpx; }.filter { pointer-events: auto; width: auto; flex: 0 0 auto; max-width: 100%; min-height: 70rpx; margin: 0; padding: 12rpx 22rpx; border: 1rpx solid var(--color-border); border-radius: 999rpx; background: #fff; color: var(--color-text); font-size: 24rpx; font-weight: 650; line-height: 1.65; box-shadow: none; }.filter::after { border: 0; }.selected { border-color: var(--color-action-soft); background: var(--color-action-soft); color: var(--color-brand); }
