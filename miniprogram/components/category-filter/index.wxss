.filters { display: flex; flex-wrap: wrap; gap: 12rpx; }.filter { display: inline-flex; pointer-events: auto; align-items: center; width: auto; flex: 0 0 auto; max-width: 100%; min-height: 74rpx; margin: 0; padding: 10rpx 18rpx 10rpx 12rpx; border: 1rpx solid var(--color-border); border-radius: 999rpx; background: #fff; color: var(--color-text); font-size: 24rpx; font-weight: 650; line-height: 1.65; box-shadow: none; }.filter-icon { width: 42rpx; height: 42rpx; margin-right: 8rpx; }.filter::after { border: 0; }.selected { border-color: #d8ceff; background: var(--color-action-soft); color: var(--color-brand); }
