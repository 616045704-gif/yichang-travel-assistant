.category-picker { display: block; width: 100%; pointer-events: auto; }
.category-select { display: flex; box-sizing: border-box; align-items: center; width: 100%; height: 80rpx; min-width: 0; padding: 0 18rpx 0 12rpx; border: 1rpx solid var(--color-border); border-radius: 20rpx; background: rgba(255, 255, 255, .97); box-shadow: 0 8rpx 22rpx rgba(53, 39, 92, .06); }
.category-select-icon { flex: 0 0 52rpx; width: 52rpx; height: 52rpx; margin-right: 8rpx; }
.category-select-label { flex: 1; min-width: 0; overflow: hidden; color: var(--color-text-strong); font-size: 24rpx; font-weight: 700; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.category-select-chevron { flex: 0 0 12rpx; width: 12rpx; height: 12rpx; margin-left: 8rpx; border-right: 3rpx solid var(--color-brand); border-bottom: 3rpx solid var(--color-brand); transform: rotate(45deg) translateY(-3rpx); }
