<view class="filters"><button size="mini" wx:for="{{options}}" wx:key="value" class="filter {{value === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="onSelect" aria-label="{{item.label + (value === item.value ? '，已选择' : '')}}"><image class="filter-icon" src="/assets/provided/category-{{item.value || 'all'}}.png" mode="aspectFit" /><text>{{item.label}}</text></button></view>
