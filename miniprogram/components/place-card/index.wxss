.place-card { overflow: hidden; border: 1rpx solid #e4d7bf; border-radius: 36rpx; background: #fcf8ef; }.cover { width: 100%; height: 320rpx; display: block; }.placeholder { background: #e9e5d5; display: flex; align-items: center; justify-content: center; color: #817969; font-size: 24rpx; }.body { padding: 28rpx; }.name { display: block; font-size: 34rpx; font-weight: 600; color: #38382e; overflow-wrap: break-word; }.district { display: block; margin-top: 6rpx; font-size: 23rpx; color: #817969; }.intro { display: block; margin-top: 16rpx; font-size: 25rpx; line-height: 1.8; color: #696555; overflow-wrap: break-word; }.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }.tag { background: #eee3cc; border-radius: 16rpx; padding: 5rpx 14rpx; color: #8b774e; font-size: 21rpx; }.favorite { min-height: 88rpx; margin: 0 28rpx 28rpx; border-radius: 28rpx; background: #ede2cb; font-size: 26rpx; line-height: 88rpx; color: #a44d3e; }.favorite::after { border: 0; }
