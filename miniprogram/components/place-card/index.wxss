.place-card { overflow: hidden; border: 1rpx solid #e4d7bf; border-radius: 36rpx; background: #fcf8ef; }.cover { width: 100%; height: 320rpx; display: block; }.placeholder { background: #e9e5d5; display: flex; align-items: center; justify-content: center; color: #817969; font-size: 24rpx; }.body { padding: 28rpx; }.name { display: block; font-size: 34rpx; font-weight: 600; color: #38382e; overflow-wrap: break-word; }.district { display: block; margin-top: 6rpx; font-size: 23rpx; color: #817969; }.intro { display: block; margin-top: 16rpx; font-size: 25rpx; line-height: 1.8; color: #696555; overflow-wrap: break-word; }.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }.tag { background: #eee3cc; border-radius: 16rpx; padding: 5rpx 14rpx; color: #8b774e; font-size: 21rpx; }.favorite-bar { display: flex; justify-content: flex-end; padding: 0 24rpx 22rpx; }.favorite { display: inline-flex; align-items: center; justify-content: center; gap: 8rpx; width: 132rpx; min-width: 132rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 32rpx; background: #ede2cb; color: #a44d3e; font-size: 23rpx; line-height: 64rpx; }.favorite-icon { position: relative; box-sizing: border-box; width: 18rpx; height: 24rpx; border: 3rpx solid currentColor; border-radius: 4rpx 4rpx 0 0; }.favorite-icon::after { content: ''; position: absolute; left: 2rpx; bottom: -7rpx; width: 9rpx; height: 9rpx; background: #ede2cb; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }.favorite-icon.is-active { background: currentColor; }.favorite::after { border: 0; }
