.place-card { overflow: hidden; border: 1rpx solid #e5e8df; border-radius: 36rpx; background: #fffefa; }.cover { width: 100%; height: 320rpx; display: block; }.placeholder { background: #e8eee2; display: flex; align-items: center; justify-content: center; color: #7a8771; font-size: 24rpx; }.body { padding: 28rpx; }.name { display: block; font-size: 34rpx; font-weight: 600; color: #203e36; overflow-wrap: break-word; }.district { display: block; margin-top: 6rpx; font-size: 23rpx; color: #788477; }.intro { display: block; margin-top: 16rpx; font-size: 25rpx; line-height: 1.8; color: #53614f; overflow-wrap: break-word; }.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }.tag { background: #f1ecdf; border-radius: 16rpx; padding: 5rpx 14rpx; color: #8b774e; font-size: 21rpx; }.favorite { min-height: 88rpx; margin: 0 28rpx 28rpx; border-radius: 28rpx; background: #e6eee1; font-size: 26rpx; line-height: 88rpx; color: #176b5b; }.favorite::after { border: 0; }
