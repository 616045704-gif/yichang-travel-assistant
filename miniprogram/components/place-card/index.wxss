.place-card { position: relative; padding: 20rpx 0; border-bottom: 1rpx solid var(--color-border); background: var(--color-surface); }
.open-area { display: flex; min-height: 152rpx; padding-right: 82rpx; }
.cover { flex: 0 0 auto; width: 152rpx; height: 152rpx; overflow: hidden; border-radius: 18rpx; background: #eeeaf1; }
.placeholder { display: flex; align-items: center; justify-content: center; color: var(--color-muted); font-size: 21rpx; line-height: 1.45; text-align: center; }
.body { display: flex; flex: 1; flex-direction: column; justify-content: center; min-width: 0; padding-left: 20rpx; }
.name { display: block; color: var(--color-text-strong); font-size: 31rpx; font-weight: 750; letter-spacing: -.5rpx; overflow-wrap: break-word; }
.district { display: block; margin-top: 5rpx; color: var(--color-brand); font-size: 22rpx; font-weight: 650; }
.intro { display: -webkit-box; margin-top: 11rpx; overflow: hidden; color: var(--color-muted); font-size: 23rpx; line-height: 1.55; overflow-wrap: break-word; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.tag { padding: 4rpx 10rpx; border-radius: 999rpx; background: var(--color-page); color: var(--color-muted); font-size: 19rpx; }
.favorite-bar { position: absolute; top: 18rpx; right: 0; }
.favorite { display: grid; width: 56rpx; min-width: 56rpx; height: 56rpx; padding: 0; border: 1rpx solid var(--color-border); border-radius: 50%; background: var(--color-surface); color: var(--color-brand); place-items: center; }
.favorite text { display: none; }
.favorite-icon { position: relative; width: 16rpx; height: 22rpx; border: 2rpx solid currentColor; border-radius: 3rpx 3rpx 0 0; }
.favorite-icon::after { position: absolute; bottom: -6rpx; left: 2rpx; width: 8rpx; height: 8rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; background: var(--color-surface); content: ''; transform: rotate(45deg); }
.favorite-icon.is-active { background: var(--color-brand); }
.favorite-icon.is-active::after { background: var(--color-brand); }
.favorite::after { border: 0; }
