.place-card { padding: 28rpx 0 32rpx; border-bottom: 1rpx solid var(--color-border); background: var(--color-surface); }
.open-area { display: block; min-width: 0; }
.cover-wrap { position: relative; width: 100%; height: 336rpx; overflow: hidden; border-radius: 24rpx; background: #eeeaf1; }
.cover { width: 100%; height: 336rpx; }
.placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 336rpx; color: var(--color-muted); font-size: 21rpx; line-height: 1.45; text-align: center; }
.category-pill { position: absolute; top: 16rpx; right: 16rpx; padding: 8rpx 14rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .9); color: var(--color-text-strong); font-size: 20rpx; font-weight: 700; line-height: 1.35; }
.cover-favorite { position: absolute; right: 14rpx; bottom: 14rpx; display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .88); }
.cover-favorite::after { border: 0; }
.favorite-image { width: 30rpx; height: 30rpx; }
.body { min-width: 0; padding: 16rpx 2rpx 0; }
.name { display: block; color: #1f1d2b; font-size: 34rpx; font-weight: 750; letter-spacing: -.6rpx; line-height: 1.35; overflow-wrap: break-word; }
