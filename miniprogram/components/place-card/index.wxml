<view wx:if="{{place}}" class="place-card">
  <view class="open-area" bindtap="onOpen" aria-role="button" aria-label="{{'查看' + place.name}}">
    <image wx:if="{{place.coverUrl && !imageFailed}}" class="cover" src="{{place.coverUrl}}" mode="aspectFill" binderror="onImageError" />
    <view wx:else class="cover placeholder">图片暂不可用</view>
    <view class="body"><text class="name">{{place.name}}</text><text class="district">{{place.district}}</text><text class="intro">{{place.intro}}</text><view class="tags"><text wx:for="{{place.tags}}" wx:key="*this" class="tag">{{item}}</text></view></view>
  </view>
  <view class="favorite-bar"><button class="favorite" loading="{{pending}}" disabled="{{pending}}" catchtap="onFavorite" aria-label="{{place.isFavorite ? '取消收藏' : '收藏地点'}}"><text class="favorite-icon">{{place.isFavorite ? '♥' : '♡'}}</text><text>{{place.isFavorite ? '已收藏' : '收藏'}}</text></button></view>
</view>
