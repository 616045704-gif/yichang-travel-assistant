.profile-card { display: flex; align-items: center; gap: 24rpx; margin: 28rpx 0; padding: 32rpx 28rpx; border: 0; border-radius: var(--radius-card); background: linear-gradient(135deg, var(--color-brand-deep), var(--color-brand)); }.profile-badge { flex: 0 0 auto; width: 96rpx; height: 96rpx; border: 12rpx solid var(--color-action); border-radius: 50%; box-shadow: inset 0 0 0 13rpx #fff; }.profile-title { display: block; color: #fff; font-size: 34rpx; font-weight: 700; }.profile-subtitle { display: block; margin-top: 8rpx; color: #e4dcff; font-size: 23rpx; }.menu { padding: 0 26rpx; }.menu-row { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--color-border); }.menu-row:last-child { border-bottom: 0; }.menu-icon { flex: 0 0 auto; width: 48rpx; height: 48rpx; border-radius: 16rpx; background: var(--color-action); }.menu-icon-history { border-radius: 50%; background: var(--color-brand); }.menu-icon-ai { background: var(--color-brand-deep); }.menu-icon-preferences { background: var(--color-action-soft); }.menu-copy { flex: 1; min-width: 0; }.menu-title { display: block; color: var(--color-brand-deep); font-size: 28rpx; font-weight: 700; }.menu-arrow { flex: 0 0 auto; width: 16rpx; height: 16rpx; border-top: 3rpx solid var(--color-brand); border-right: 3rpx solid var(--color-brand); transform: rotate(45deg); }.privacy-button { display: flex; justify-content: space-between; width: 100%; min-height: 88rpx; margin-top: 24rpx; padding: 26rpx; color: var(--color-brand-deep); font-size: 28rpx; font-weight: 700; line-height: 1.5; }.personal-note { display: block; margin: 24rpx 8rpx; }
