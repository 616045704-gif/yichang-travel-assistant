.profile-card { display: flex; align-items: center; gap: 24rpx; background: #e7ecdf; border-radius: 36rpx; padding: 36rpx 30rpx; margin: 28rpx 0; }.profile-seal { flex-shrink: 0; border-radius: 50%; background: #d6dfc8; color: #42684f; width: 100rpx; height: 100rpx; line-height: 100rpx; font-size: 44rpx; text-align: center; }.profile-title { display: block; font-size: 34rpx; font-weight: 600; }.profile-subtitle { display: block; margin-top: 8rpx; font-size: 23rpx; color: #6d7d67; }.menu { padding: 0 26rpx; }.menu-row { display: flex; align-items: center; gap: 22rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--color-border); }.menu-row:last-child { border-bottom: 0; }.menu-symbol { font-size: 36rpx; width: 40rpx; color: var(--color-primary); flex-shrink: 0; }.menu-copy { flex: 1; min-width: 0; }.menu-title { display: block; font-size: 28rpx; }.menu-status { font-size: 21rpx; color: #8c967e; flex-shrink: 0; }.privacy-button { margin-top: 24rpx; width: 100%; display: flex; justify-content: space-between; padding: 26rpx; line-height: 1.5; min-height: 88rpx; font-size: 28rpx; color: var(--color-text); }.personal-note { display: block; margin: 24rpx 8rpx; }
