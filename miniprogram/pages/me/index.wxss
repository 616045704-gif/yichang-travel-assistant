.me-page { padding-top: 42rpx; background: var(--color-surface); }.profile-card { display: flex; align-items: center; gap: 22rpx; margin: 30rpx 0 34rpx; padding: 26rpx 0; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); border-radius: 0; background: transparent; }.profile-badge { position: relative; flex: 0 0 auto; width: 86rpx; height: 86rpx; border-radius: 50%; background: var(--color-action-soft); }.profile-badge::before { position: absolute; top: 29rpx; left: 29rpx; width: 28rpx; height: 28rpx; border-radius: 50%; background: var(--color-brand); content: ''; }.profile-title { display: block; color: var(--color-text-strong); font-size: 34rpx; font-weight: 750; }.profile-subtitle { display: block; margin-top: 7rpx; color: var(--color-muted); font-size: 23rpx; }.menu { padding: 0; border: 0; border-radius: 0; box-shadow: none; }.menu-row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--color-border); }.menu-row:last-child { border-bottom: 1rpx solid var(--color-border); }.menu-icon { flex: 0 0 auto; width: 66rpx; height: 66rpx; }.menu-copy { flex: 1; min-width: 0; }.menu-title { display: block; color: var(--color-text-strong); font-size: 28rpx; font-weight: 700; }.menu-arrow { flex: 0 0 auto; width: 14rpx; height: 14rpx; border-top: 3rpx solid var(--color-brand); border-right: 3rpx solid var(--color-brand); transform: rotate(45deg); }.privacy-button { display: flex; justify-content: space-between; width: 100%; min-height: 88rpx; margin-top: 0; padding: 26rpx 0; border: 0; border-bottom: 1rpx solid var(--color-border); border-radius: 0; background: transparent; color: var(--color-text-strong); font-size: 28rpx; font-weight: 700; line-height: 1.5; }.personal-note { display: block; margin: 24rpx 0; }
