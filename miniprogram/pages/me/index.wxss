.profile-card { display: flex; align-items: center; gap: 24rpx; background: linear-gradient(110deg, #e9e5d5, #f5eddf); border: 1rpx solid #d4c5a3; border-radius: 20rpx; padding: 36rpx 30rpx; margin: 28rpx 0; }
.profile-seal { flex-shrink: 0; border-radius: 16rpx; background: #a44d3e; border: 5rpx double #f0d9ae; color: #fff5dd; width: 100rpx; height: 100rpx; line-height: 90rpx; font-family: var(--font-display); font-size: 48rpx; text-align: center; transform: rotate(-4deg); }
.profile-title { display: block; font-family: var(--font-display); font-size: 34rpx; font-weight: 600; }.profile-subtitle { display: block; margin-top: 8rpx; font-size: 23rpx; color: #7c765f; }
.menu { padding: 0 26rpx; }.menu-row { display: flex; align-items: center; gap: 22rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--color-border); }.menu-row:last-child { border-bottom: 0; }.menu-symbol { font-size: 34rpx; width: 44rpx; color: #a58c55; flex-shrink: 0; }.menu-copy { flex: 1; min-width: 0; }.menu-title { display: block; font-size: 28rpx; }.menu-status { font-size: 21rpx; color: #8a8069; flex-shrink: 0; }
.privacy-button { margin-top: 24rpx; width: 100%; display: flex; justify-content: space-between; padding: 26rpx; line-height: 1.5; min-height: 88rpx; font-size: 28rpx; color: var(--color-text); }.personal-note { display: block; margin: 24rpx 8rpx; }
