.me-page { min-height: 100vh; padding-top: 24rpx; background: var(--color-page); }
.travel-hero { position: relative; height: 264rpx; overflow: hidden; padding: 38rpx 34rpx; border: 1rpx solid rgba(116, 84, 216, .08); border-radius: 34rpx; background: linear-gradient(135deg, #fbfaff 0%, #f1edff 58%, #fbfaf6 100%); }
.travel-hero .chapter-heading { position: relative; z-index: 2; margin: 0; }
.travel-hero .page-title { max-width: 440rpx; font-size: 42rpx; line-height: 1.18; }
.travel-motif { position: absolute; z-index: 1; width: 150rpx; height: 150rpx; opacity: .14; pointer-events: none; }
.travel-motif-scenic { right: 16rpx; bottom: -12rpx; transform: rotate(-5deg); }
.travel-motif-camping { top: -34rpx; right: 148rpx; width: 112rpx; height: 112rpx; transform: rotate(8deg); }
.travel-route { position: absolute; z-index: 1; right: 42rpx; bottom: 92rpx; width: 222rpx; border-top: 4rpx dotted rgba(116, 84, 216, .26); transform: rotate(-14deg); pointer-events: none; }
.travel-route::before, .travel-route::after { position: absolute; top: -8rpx; width: 12rpx; height: 12rpx; border: 3rpx solid rgba(116, 84, 216, .34); border-radius: 50%; background: #f8f6ff; content: ''; }
.travel-route::before { left: -2rpx; }
.travel-route::after { right: -2rpx; }
.profile-card { position: relative; z-index: 3; display: flex; align-items: center; gap: 20rpx; margin-top: -52rpx; margin-right: 20rpx; margin-bottom: 30rpx; margin-left: 20rpx; padding: 24rpx; border: 1rpx solid rgba(116, 84, 216, .10); border-radius: 26rpx; background: var(--color-surface); box-shadow: 0 14rpx 34rpx rgba(53, 39, 92, .10); }
.profile-icon-shell { display: flex; flex: 0 0 84rpx; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 24rpx; background: #f0ecff; }
.profile-icon { width: 72rpx; height: 72rpx; }
.profile-title { display: block; color: var(--color-text-strong); font-size: 32rpx; font-weight: 750; }
.profile-subtitle { display: block; margin-top: 6rpx; color: var(--color-muted); font-size: 23rpx; }
.menu { overflow: hidden; padding: 0 22rpx; border: 1rpx solid rgba(90, 70, 138, .10); border-radius: 30rpx; background: var(--color-surface); }
.menu-row { display: flex; align-items: center; gap: 18rpx; min-height: 124rpx; padding: 16rpx 2rpx; border-bottom: 1rpx solid var(--color-border); }
.menu-row.menu-row-pressed { margin: 0 -10rpx; padding-right: 12rpx; padding-left: 12rpx; background: var(--color-brand-soft); }
.menu-row:last-child { border-bottom: 0; }
.menu-icon-shell { display: flex; flex: 0 0 88rpx; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 24rpx; }
.menu-icon-shell-favorite { background: #fff1f1; }
.menu-icon-shell-history { background: #edf8fb; }
.menu-icon-shell-ai { background: #f0ecff; }
.menu-icon-shell-preferences { background: #fff8df; }
.menu-icon { flex: 0 0 auto; width: 72rpx; height: 72rpx; }
.menu-copy { flex: 1; min-width: 0; }
.menu-title { display: block; color: var(--color-text-strong); font-size: 28rpx; font-weight: 700; }
.menu-copy .note { display: block; margin-top: 5rpx; font-size: 22rpx; }
.menu-arrow { flex: 0 0 auto; width: 14rpx; height: 14rpx; margin-right: 6rpx; border-top: 3rpx solid var(--color-brand); border-right: 3rpx solid var(--color-brand); transform: rotate(45deg); }
.privacy-button { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; min-height: 92rpx; margin-top: 20rpx; padding: 0 28rpx; border: 1rpx solid rgba(90, 70, 138, .10); border-radius: 24rpx; background: var(--color-surface); color: var(--color-text-strong); font-size: 27rpx; font-weight: 700; line-height: 1.5; }
.privacy-button::after { border: 0; }
.privacy-button.privacy-button-pressed { background: var(--color-brand-soft); }
.personal-note { display: block; margin: 24rpx 8rpx 18rpx; line-height: 1.7; }
.footer-note { margin-left: 8rpx; }
