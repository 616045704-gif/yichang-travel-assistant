.profile-card { display: flex; align-items: center; gap: 22rpx; margin: 30rpx 0 34rpx; padding: 28rpx 0; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); border-radius: 0; background: transparent; }.profile-badge { position: relative; flex: 0 0 auto; width: 86rpx; height: 86rpx; border: 2rpx solid var(--color-brand); border-radius: 50%; }.profile-badge::before { position: absolute; top: 17rpx; left: 27rpx; width: 26rpx; height: 26rpx; border: 3rpx solid var(--color-brand); border-radius: 50%; content: ''; }.profile-badge::after { position: absolute; bottom: 13rpx; left: 17rpx; width: 47rpx; height: 22rpx; border-top: 3rpx solid var(--color-brand); border-radius: 50% 50% 0 0; content: ''; }.profile-title { display: block; color: var(--color-text-strong); font-size: 34rpx; font-weight: 750; }.profile-subtitle { display: block; margin-top: 7rpx; color: var(--color-muted); font-size: 23rpx; }.menu { padding: 0; border: 0; border-radius: 0; box-shadow: none; }.menu-row { display: flex; align-items: center; gap: 20rpx; padding: 25rpx 0; border-bottom: 1rpx solid var(--color-border); }.menu-row:last-child { border-bottom: 1rpx solid var(--color-border); }.menu-icon { position: relative; flex: 0 0 auto; width: 48rpx; height: 48rpx; border: 2rpx solid var(--color-brand); border-radius: 15rpx; }.menu-icon-history { border-radius: 50%; }.menu-icon-ai::before { position: absolute; top: 12rpx; left: 10rpx; width: 22rpx; height: 16rpx; border: 3rpx solid var(--color-brand); border-radius: 8rpx; content: ''; }.menu-icon-preferences::before, .menu-icon-preferences::after { position: absolute; left: 11rpx; width: 23rpx; border-top: 3rpx solid var(--color-brand); content: ''; }.menu-icon-preferences::before { top: 15rpx; }.menu-icon-preferences::after { top: 28rpx; }.menu-copy { flex: 1; min-width: 0; }.menu-title { display: block; color: var(--color-text-strong); font-size: 28rpx; font-weight: 700; }.menu-arrow { flex: 0 0 auto; width: 14rpx; height: 14rpx; border-top: 3rpx solid var(--color-brand); border-right: 3rpx solid var(--color-brand); transform: rotate(45deg); }.privacy-button { display: flex; justify-content: space-between; width: 100%; min-height: 88rpx; margin-top: 0; padding: 26rpx 0; border: 0; border-bottom: 1rpx solid var(--color-border); border-radius: 0; background: transparent; color: var(--color-text-strong); font-size: 28rpx; font-weight: 700; line-height: 1.5; }.personal-note { display: block; margin: 24rpx 0; }
