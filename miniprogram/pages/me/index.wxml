<view class="page me-page">
  <view class="travel-hero">
    <view class="travel-copy">
      <text class="travel-kicker">我的旅行</text>
      <text class="travel-title">留下你的出发线索</text>
      <text class="travel-subtitle">去看更大的世界，遇见更好的自己 ✨</text>
    </view>
    <view class="travel-illustration" aria-hidden="true">
      <image class="travel-motif travel-motif-scenic" src="/assets/provided/category-scenic.png" mode="aspectFit" />
      <image class="travel-motif travel-motif-camping" src="/assets/provided/category-camping.png" mode="aspectFit" />
      <view class="travel-route"><view class="travel-route-dot route-dot-start"></view><view class="travel-route-dot route-dot-end"></view></view>
      <view class="travel-plane"></view>
    </view>
    <view class="profile-card">
      <view class="profile-avatar-art"><view class="profile-avatar-halo"><image class="profile-icon" src="/assets/provided/tab-me-active.png" mode="aspectFit" aria-hidden="true" /></view><view class="profile-flight-badge" aria-hidden="true"></view></view>
      <view class="profile-copy"><text class="profile-title">你好，旅行者</text><text class="profile-subtitle">收藏灵感，规划下一段出发。</text></view>
      <text class="profile-script" aria-hidden="true">Let's Go</text>
    </view>
  </view>
  <view class="menu"><view wx:for="{{entries}}" wx:key="title" class="menu-row" hover-class="menu-row-pressed" bindtap="openEntry" data-url="{{item.url}}"><view class="menu-icon-shell menu-icon-shell-{{item.icon}}"><image class="menu-icon" src="/assets/provided/menu-{{item.icon}}.png" mode="aspectFit" aria-hidden="true" /></view><view class="menu-copy"><text class="menu-title">{{item.title}}</text><text class="note">{{item.description}}</text></view><view class="menu-arrow" aria-hidden="true"></view></view></view>
  <button class="privacy-button" hover-class="privacy-button-pressed" bindtap="showPrivacy"><text>隐私说明</text><view class="menu-arrow" aria-hidden="true"></view></button>
  <text class="note personal-note">收藏、浏览、旅行偏好与 AI 问答记录只向对应用户展示。</text>
  <text class="footer-note">宜昌旅游助手 · 基础版</text>
</view>
