<view class="page home-page">
  <view class="home-hero" bindtap="openDiscover" aria-role="button" aria-label="浏览宜昌地点">
    <image class="home-hero-image" src="/assets/provided/home-hero.jpg" mode="aspectFill" />
    <view class="home-hero-shade"></view>
    <button class="home-hero-action" catchtap="openDiscover">出发吧</button>
  </view>

  <view class="ai-quick-grid">
    <view class="ai-quick-card" hover-class="ai-quick-card-pressed" bindtap="openAiChat" aria-role="button" aria-label="自由问答"><image class="ai-quick-image" src="/assets/provided/ai-chat.png" mode="aspectFill" /></view>
    <view class="ai-quick-card" hover-class="ai-quick-card-pressed" bindtap="openTripForm" aria-role="button" aria-label="行程定制"><image class="ai-quick-image" src="/assets/provided/trip-plan.png" mode="aspectFill" /></view>
  </view>

  <view class="category-separator"></view>
  <view class="category-heading"><view class="category-heading-mark" aria-hidden="true"></view><text class="category-heading-title">分类</text></view>
  <view class="category-grid">
    <view wx:for="{{categories}}" wx:key="value" class="category-tile" data-category="{{item.value}}" bindtap="onCategoryTap" aria-role="button" aria-label="{{'查看' + item.label}}"><image src="/assets/provided/category-{{item.value}}.png" class="category-icon" mode="aspectFit" aria-hidden="true" /><text class="category-label">{{item.label}}</text></view>
  </view>

  <view wx:if="{{featuredStatus === 'ready'}}" class="featured-list"><place-card wx:for="{{featured}}" wx:key="placeId" place="{{item}}" bind:open="openPlace" bind:favoritechange="onFavorite" /></view>
  <view wx:else class="state-shell"><async-state status="{{featuredStatus}}" title="地点暂不可用" message="请稍后重试。" /></view>
</view><feedback-toast visible="{{feedback.visible}}" tone="{{feedback.tone}}" message="{{feedback.message}}" bind:dismiss="onFeedbackDismiss" />
