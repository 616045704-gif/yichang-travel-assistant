.home-page { padding-top: 24rpx; padding-bottom: 62rpx; background: var(--color-surface); }
.home-hero { position: relative; height: 560rpx; overflow: hidden; border-radius: 28rpx; background: #dfeaff; }
.home-hero-image { width: 100%; height: 100%; }
.home-hero-shade { display: none; }
.home-hero-action { position: absolute; top: 50%; left: 50%; min-height: 58rpx; margin: 0; padding: 0 24rpx; border: 1rpx solid rgba(255, 255, 255, .82); border-radius: 999rpx; background: rgba(255, 255, 255, .94); color: var(--color-brand); font-size: 24rpx; font-weight: 750; line-height: 58rpx; transform: translate(-50%, -50%); box-shadow: 0 8rpx 20rpx rgba(38, 31, 58, .14); }
.ai-quick-grid { display: grid; grid-template-columns: repeat(2, 288rpx); justify-content: center; gap: 20rpx; margin-top: 32rpx; }
.ai-quick-card { display: flex; align-items: center; justify-content: center; width: 288rpx; min-width: 0; padding: 0; overflow: visible; border: 0; border-radius: 26rpx; background: transparent; line-height: 0; }
.ai-quick-image { display: block; width: 100%; overflow: hidden; border-radius: 24rpx; box-shadow: 0 10rpx 26rpx rgba(53, 39, 92, .08); }
.category-separator { height: 12rpx; margin: 32rpx -32rpx 0; background: #f1eff7; }
.category-heading { display: flex; align-items: center; gap: 12rpx; margin-top: 28rpx; }
.category-heading-mark { flex: 0 0 12rpx; width: 12rpx; height: 30rpx; border-radius: 999rpx; background: var(--color-brand); }
.category-heading-title { color: var(--color-text-strong); font-size: 36rpx; font-weight: 750; letter-spacing: -.6rpx; line-height: 1.3; }
.category-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6rpx; margin-top: 20rpx; padding: 0 0 22rpx; border-bottom: 1rpx solid var(--color-border); }
.category-tile { display: flex; flex-direction: column; align-items: center; gap: 10rpx; min-width: 0; padding: 6rpx 0; }
.category-icon { width: 128rpx; height: 128rpx; }
.category-label { color: var(--color-text); font-size: 22rpx; font-weight: 650; text-align: center; }
.featured-list { margin-top: 28rpx; }
.state-shell { margin-top: 28rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-card); background: var(--color-page); }
