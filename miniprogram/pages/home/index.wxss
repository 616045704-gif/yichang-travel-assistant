.home-page { padding: 0 0 44rpx; }.hero { position: relative; height: 560rpx; overflow: hidden; background: linear-gradient(135deg, var(--color-brand-deep), var(--color-brand)); }.hero-copy { position: relative; z-index: 2; padding: 72rpx 42rpx 0; }.hero-kicker { display: block; color: var(--color-action); font-size: 21rpx; font-weight: 700; letter-spacing: 3rpx; }.hero-title { display: block; margin-top: 14rpx; color: #fff; font-size: 72rpx; font-weight: 700; line-height: 1.16; }.hero-caption { display: block; margin-top: 18rpx; color: #e7defe; font-size: 27rpx; }.hero-orbit { position: absolute; border: 20rpx solid rgba(255, 255, 255, .10); border-radius: 50%; }.orbit-one { top: -180rpx; right: -140rpx; width: 440rpx; height: 440rpx; }.orbit-two { right: 80rpx; bottom: -130rpx; width: 270rpx; height: 270rpx; border-width: 12rpx; }.hero-river { position: absolute; right: -90rpx; bottom: 8rpx; width: 540rpx; height: 160rpx; border: 34rpx solid var(--color-action); border-color: var(--color-action) transparent transparent; border-radius: 50%; transform: rotate(-17deg); opacity: .9; }.hero-pin { position: absolute; right: 84rpx; top: 92rpx; width: 36rpx; height: 36rpx; border-radius: 50% 50% 50% 0; background: var(--color-action); transform: rotate(-45deg); }.hero-button { position: absolute; z-index: 2; bottom: 42rpx; left: 40rpx; display: flex; align-items: center; justify-content: space-between; width: 288rpx; min-height: 88rpx; padding: 18rpx 28rpx; border-radius: 999rpx; background: var(--color-action); color: var(--color-brand-deep); font-size: 26rpx; font-weight: 700; }.action-arrow { position: relative; width: 22rpx; height: 22rpx; border-top: 4rpx solid currentColor; border-right: 4rpx solid currentColor; transform: rotate(45deg); }.home-content { position: relative; padding: 0 32rpx; margin-top: -24rpx; }.category-panel { padding: 28rpx 20rpx; }.category-heading { display: flex; justify-content: space-between; margin: 0 8rpx 24rpx; color: var(--color-brand-deep); font-size: 28rpx; font-weight: 700; }.category-heading text:last-child { color: var(--color-muted); font-size: 22rpx; font-weight: 400; }.category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; }.category-tile { display: flex; align-items: center; flex-direction: column; min-width: 0; gap: 12rpx; }.category-icon-wrap { display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; border-radius: 28rpx; background: var(--color-page); }.category-icon { width: 66rpx; height: 66rpx; }.category-label { color: var(--color-text); font-size: 23rpx; font-weight: 650; text-align: center; }.ai-entry { margin: 28rpx 0 0; padding: 30rpx; border-radius: var(--radius-card); background: var(--color-brand-deep); box-shadow: var(--shadow-card); }.ai-kicker { display: block; color: var(--color-action); font-size: 19rpx; font-weight: 700; letter-spacing: 2rpx; }.ai-title { display: block; margin: 8rpx 0; color: #fff; font-size: 38rpx; font-weight: 700; }.ai-copy .note { display: block; color: #dfd5ff; }.ai-entry-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 24rpx; }.ai-action { position: relative; display: flex; flex-direction: column; align-items: flex-start; min-width: 0; min-height: 172rpx; margin: 0; padding: 20rpx; border-radius: 22rpx; text-align: left; }.ai-action-chat { background: #fff; color: var(--color-brand-deep); }.ai-action-trip { background: var(--color-action); color: var(--color-brand-deep); }.ai-action-kicker { font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; opacity: .72; }.ai-action-title { margin-top: 8rpx; font-size: 29rpx; font-weight: 700; }.ai-action-note { margin-top: 8rpx; font-size: 20rpx; line-height: 1.45; }.ai-action .action-arrow { position: absolute; right: 22rpx; bottom: 20rpx; width: 18rpx; height: 18rpx; }.disclaimer { display: block; padding: 20rpx 6rpx 0; color: var(--color-muted); font-size: 21rpx; line-height: 1.55; }
