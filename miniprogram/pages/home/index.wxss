.home-page { padding-top: 24rpx; padding-bottom: 62rpx; background: var(--color-surface); }
.home-hero { position: relative; height: 560rpx; overflow: hidden; border-radius: 28rpx; background: #dfeaff; }
.home-hero-image { width: 100%; height: 100%; }
.home-hero-shade { position: absolute; right: 0; bottom: 0; left: 0; height: 154rpx; background: linear-gradient(180deg, transparent, rgba(24, 27, 48, .38)); }
.home-hero-action { position: absolute; right: 24rpx; bottom: 24rpx; display: flex; align-items: center; gap: 12rpx; min-height: 64rpx; padding: 0 22rpx; border: 0; border-radius: 999rpx; background: rgba(255, 255, 255, .94); color: var(--color-text-strong); font-size: 23rpx; font-weight: 700; line-height: 1; }
.hero-arrow { width: 12rpx; height: 12rpx; border-top: 3rpx solid var(--color-brand); border-right: 3rpx solid var(--color-brand); transform: rotate(45deg); }
.ai-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 28rpx; }
.ai-quick-card { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 0; min-height: 266rpx; padding: 24rpx 18rpx; overflow: hidden; border: 1rpx solid var(--color-border); border-radius: 26rpx; background: linear-gradient(145deg, #fff 54%, #f6f3ff); color: var(--color-text); text-align: center; }
.ai-quick-card + .ai-quick-card { background: linear-gradient(145deg, #fff 54%, #f1f8ff); }
.ai-quick-image { width: 136rpx; height: 136rpx; }
.ai-quick-title { display: block; margin-top: 12rpx; color: var(--color-text-strong); font-size: 30rpx; font-weight: 750; letter-spacing: -.4rpx; line-height: 1.32; }
.category-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6rpx; margin-top: 36rpx; padding: 0 0 20rpx; border-bottom: 1rpx solid var(--color-border); }
.category-tile { display: flex; flex-direction: column; align-items: center; gap: 10rpx; min-width: 0; padding: 6rpx 0; }
.category-icon { width: 96rpx; height: 96rpx; }
.category-label { color: var(--color-text); font-size: 22rpx; font-weight: 650; text-align: center; }
.featured-list { margin-top: 38rpx; border-top: 1rpx solid var(--color-border); }
.state-shell { margin-top: 38rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-card); background: var(--color-page); }
