.record-list { padding: 0 28rpx; background: var(--color-surface); }.record-row { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 0; border-bottom: 1rpx solid var(--color-border); }.record-row:last-child { border-bottom: 0; }.record-title { display: block; color: var(--color-text-strong); font-size: 30rpx; font-weight: 700; }.record-arrow { width: 14rpx; height: 14rpx; margin-right: 8rpx; border-top: 3rpx solid var(--color-brand); border-right: 3rpx solid var(--color-brand); transform: rotate(45deg); }.remove-button { min-height: 54rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid var(--color-danger); border-radius: 999rpx; background: var(--color-danger-soft); color: var(--color-danger); font-size: 23rpx; line-height: 54rpx; }
