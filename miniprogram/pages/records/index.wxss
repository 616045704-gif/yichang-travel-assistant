.record-list { padding: 0 28rpx; }.record-row { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; border-bottom: 1rpx solid var(--color-border); }.record-row:last-child { border-bottom: 0; }.record-title { display: block; font-size: 30rpx; }.arrow { color: var(--color-gold-dark); }.remove-button { margin: 0; padding: 4rpx 18rpx; background: #f5eddf; color: #a44d3e; border: 1rpx solid #a44d3e; font-size: 23rpx; }
