<view class="page">
  <view class="chapter-heading"><view><text class="eyebrow">PRIVATE TRAVEL</text><text class="page-title">{{title}}</text></view></view>
  <view wx:if="{{status === 'ready'}}" class="card record-list"><view wx:for="{{items}}" wx:key="recordId" class="record-row" bindtap="openPlace" data-place-id="{{item.placeId}}"><view><text class="record-title">{{item.name}}</text><text class="note">{{item.recordedAt}}</text></view><button wx:if="{{item.unavailable && type === 'favorites'}}" class="remove-button" catchtap="removeUnavailableFavorite" data-place-id="{{item.placeId}}">移除</button><view wx:elif="{{!item.unavailable}}" class="record-arrow" aria-hidden="true"></view></view></view>
  <async-state wx:else status="{{status}}" title="{{status === 'empty' ? '还没有记录' : '记录暂不可用'}}" message="{{status === 'empty' ? '浏览地点或收藏喜欢的地方后，会在这里出现。' : message}}" bind:retry="onRetry" />
  <feedback-toast visible="{{feedback.visible}}" tone="{{feedback.tone}}" message="{{feedback.message}}" bind:dismiss="onFeedbackDismiss" />
</view>
