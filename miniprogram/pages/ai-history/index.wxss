.history-page { display: flex; flex-direction: column; gap: 22rpx; }.history-tabs { display: flex; gap: 12rpx; padding: 8rpx; border-radius: 22rpx; background: var(--color-surface); }.history-tab { flex: 1; padding: 16rpx; border-radius: 16rpx; color: var(--color-muted); font-size: 25rpx; text-align: center; }.history-tab-active { background: var(--color-brand-deep); color: #fff; font-weight: 700; }.disclaimer { padding: 18rpx 20rpx; border-left: 6rpx solid var(--color-action); border-radius: 16rpx; background: var(--color-action-soft); color: var(--color-brand-deep); font-size: 23rpx; line-height: 1.7; }.history-list { display: flex; flex-direction: column; gap: 20rpx; }.history-item { display: flex; flex-direction: column; gap: 16rpx; }.history-summary { display: flex; flex-direction: column; gap: 12rpx; padding: 26rpx; border: 1rpx solid var(--color-border); border-radius: 24rpx; background: var(--color-surface); box-shadow: 0 12rpx 26rpx rgba(43, 23, 77, 0.06); }.history-summary-meta { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.history-title { color: var(--color-brand); font-size: 24rpx; font-weight: 800; }.history-time { color: var(--color-muted); font-size: 22rpx; }.history-prompt { display: -webkit-box; overflow: hidden; color: var(--color-text-strong); font-size: 27rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.history-toggle { color: var(--color-brand); font-size: 23rpx; font-weight: 700; }.history-detail { display: flex; flex-direction: column; gap: 16rpx; }.empty-card { display: flex; flex-direction: column; gap: 12rpx; padding: 32rpx 28rpx; }.empty-title { font-size: 32rpx; color: var(--color-brand-deep); font-weight: 800; }
