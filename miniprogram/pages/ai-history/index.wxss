.history-page { display: flex; flex-direction: column; gap: 22rpx; }
.history-tabs { display: flex; gap: 12rpx; }
.history-tab { flex: 1; padding: 16rpx; border: 1rpx solid #dccdab; border-radius: 18rpx; color: #76674f; font-size: 25rpx; text-align: center; }
.history-tab-active { border-color: var(--color-primary); background: var(--color-primary); color: #fffaf0; font-weight: 600; }
.disclaimer { padding: 18rpx 20rpx; border-left: 6rpx solid var(--color-gold); background: #eee3cc; color: #6d604a; font-size: 23rpx; line-height: 1.7; }
.history-list { display: flex; flex-direction: column; gap: 20rpx; }
.history-item { display: flex; flex-direction: column; gap: 16rpx; }
.history-summary { display: flex; flex-direction: column; gap: 12rpx; padding: 24rpx; border: 1rpx solid #e3d7bd; border-radius: 20rpx; background: #fffaf0; }
.history-summary-meta { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.history-title { color: var(--color-gold-dark); font-size: 24rpx; font-weight: 600; }
.history-time { color: #8f826c; font-size: 22rpx; }
.history-prompt { display: -webkit-box; overflow: hidden; color: var(--color-ink); font-size: 27rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.history-toggle { color: #7d6640; font-size: 23rpx; }
.history-detail { display: flex; flex-direction: column; gap: 16rpx; }
.empty-card { display: flex; flex-direction: column; gap: 12rpx; padding: 32rpx 28rpx; }
.empty-title { font-family: var(--font-display); font-size: 32rpx; color: var(--color-ink); }
