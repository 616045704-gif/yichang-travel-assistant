.history-page { display: flex; flex-direction: column; gap: 22rpx; }.session-note { align-self: flex-start; padding: 7rpx 16rpx; border-radius: 18rpx; background: var(--color-gold-light); color: #886b3d; font-size: 22rpx; }.disclaimer { padding: 18rpx 20rpx; border-left: 6rpx solid var(--color-gold); background: #eee3cc; color: #6d604a; font-size: 23rpx; line-height: 1.7; }.history-list { display: flex; flex-direction: column; gap: 20rpx; }.history-item { display: flex; flex-direction: column; gap: 14rpx; }.history-title { color: var(--color-gold-dark); font-size: 24rpx; font-weight: 600; }.empty-card { display: flex; flex-direction: column; gap: 12rpx; padding: 32rpx 28rpx; }.empty-title { font-family: var(--font-display); font-size: 32rpx; color: var(--color-ink); }
