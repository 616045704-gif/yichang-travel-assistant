<view class="page trip-page">
  <view class="chapter-heading">
    <view>
      <text class="eyebrow">YICHANG TRIP PLANNER</text>
      <text class="page-title">定制宜昌行程</text>
    </view>
  </view>
  <text class="disclaimer">内容仅供出行参考，请以景区、交通等官方公告为准</text>
  <text class="budget-note">预算为全团总预算，不含往返宜昌大交通。</text>

  <view class="form-card card">
    <label class="field"><text>目的地</text><input value="{{form.destination}}" placeholder="如：宜昌城区、三峡大坝" bindinput="onDestination" /></label>
    <label class="field"><text>人数</text><input type="number" value="{{form.people}}" placeholder="1–20 人" bindinput="onPeople" /></label>
    <label class="field"><text>总预算（元）</text><input type="digit" value="{{form.totalBudgetCny}}" placeholder="1–100000" bindinput="onBudget" /></label>
    <label class="field"><text>天数</text><input type="number" value="{{form.days}}" placeholder="1–7 天" bindinput="onDays" /></label>
    <view class="field">
      <text>旅行偏好（最多 6 项）</text>
      <view class="preference-list">
        <button wx:for="{{preferenceOptions}}" wx:key="value" class="preference {{item.selected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="onTogglePreference">{{item.value}}</button>
      </view>
    </view>
    <view wx:if="{{errors.length}}" class="validation-errors"><text wx:for="{{errors}}" wx:key="*this">{{item}}</text></view>
  </view>

  <view wx:if="{{isSubmitting}}" class="waiting"><text>正在生成行程建议，请稍候…</text></view>
  <view wx:if="{{error}}" class="error-panel"><text>{{error}}</text><button class="button-secondary retry-button" bindtap="retry">重试</button></view>

  <view wx:if="{{result}}" class="current-plan card">
    <text class="current-plan-title">{{confirmedRequirements.length ? '当前完整行程（已应用调整）' : '当前计划（可继续调整）'}}</text>
    <message-bubble role="assistant" content="{{result.answer}}" mode="{{result.mode}}" label="模拟回答，仅用于交互测试" />
    <source-card facts="{{result.localFacts}}" references="{{result.references}}" />
  </view>

  <view wx:if="{{results.length}}" class="confirmed-requirements card">
    <text class="confirmed-title">已确认要求（每次都会用于完整重新生成）</text>
    <view wx:if="{{confirmedRequirements.length}}" class="confirmed-list">
      <text wx:for="{{confirmedRequirements}}" wx:key="*this" class="confirmed-item">{{index + 1}}. {{item}}</text>
    </view>
    <text wx:else class="confirmed-empty">暂未补充额外要求；发送调整后会重新生成全程。</text>
  </view>

  <view wx:if="{{results.length}}" class="adjustment-card card">
    <text wx:if="{{adjustmentError}}" class="adjustment-error">{{adjustmentError}}</text>
    <button class="button-primary adjustment-button" disabled="{{isSubmitting}}" bindtap="openAdjustmentPage">调整行程</button>
    <button class="button-secondary restart-button" disabled="{{isSubmitting}}" bindtap="restartTrip">重新规划</button>
  </view>

  <button wx:if="{{!results.length}}" class="button-primary submit-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="submit">生成行程</button>
</view>
