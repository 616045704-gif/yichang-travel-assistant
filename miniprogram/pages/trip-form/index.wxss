.trip-page { display: flex; flex-direction: column; gap: 22rpx; }.disclaimer, .budget-note { padding: 18rpx 20rpx; border-left: 6rpx solid var(--color-action); border-radius: 16rpx; background: var(--color-action-soft); color: var(--color-brand-deep); font-size: 23rpx; line-height: 1.7; }.budget-note { margin-top: -12rpx; border-left-color: var(--color-brand); background: var(--color-brand-soft); color: var(--color-brand-deep); }.form-card, .current-plan, .confirmed-requirements, .adjustment-card { display: flex; flex-direction: column; gap: 16rpx; padding: 28rpx; }.field { display: flex; flex-direction: column; gap: 12rpx; color: var(--color-text); font-size: 27rpx; font-weight: 700; }.field input { height: 80rpx; padding: 0 20rpx; border: 1rpx solid var(--color-border); border-radius: 16rpx; background: var(--color-page); font-size: 27rpx; font-weight: 400; }.preference-list { display: flex; flex-wrap: wrap; gap: 14rpx; }.preference { min-height: 62rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid var(--color-border); border-radius: 999rpx; background: var(--color-page); color: var(--color-text); font-size: 23rpx; font-weight: 400; line-height: 62rpx; }.preference.selected { border-color: var(--color-brand); background: var(--color-brand); color: #fff; font-weight: 700; }.validation-errors { display: flex; flex-direction: column; gap: 6rpx; color: var(--color-danger); font-size: 24rpx; }.waiting { padding: 18rpx 22rpx; border-radius: 18rpx; background: var(--color-surface); color: var(--color-muted); font-size: 24rpx; }.error-panel { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 20rpx; border: 1rpx solid var(--color-danger); border-radius: 20rpx; background: var(--color-danger-soft); color: var(--color-danger); font-size: 25rpx; }.retry-button { flex-shrink: 0; min-height: 66rpx; padding: 10rpx 22rpx; border: 1rpx solid var(--color-brand); color: var(--color-brand); font-size: 24rpx; }.current-plan { border: 2rpx solid var(--color-brand); }.current-plan-title, .confirmed-title { color: var(--color-brand-deep); font-size: 29rpx; font-weight: 800; }.confirmed-requirements { border-top: 8rpx solid var(--color-action); background: var(--color-surface); }.confirmed-list { display: flex; flex-direction: column; gap: 10rpx; }.confirmed-item, .confirmed-empty { color: var(--color-text); font-size: 25rpx; line-height: 1.6; }.adjustment-field { display: flex; flex-direction: column; gap: 12rpx; color: var(--color-text); font-size: 27rpx; font-weight: 700; }.adjustment-field textarea { width: 100%; min-height: 144rpx; padding: 20rpx; border: 1rpx solid var(--color-border); border-radius: 16rpx; background: var(--color-page); font-size: 27rpx; font-weight: 400; line-height: 1.6; }.adjustment-error { color: var(--color-danger); font-size: 24rpx; }.adjustment-button, .submit-button { width: 100%; }.restart-button { color: var(--color-brand); font-size: 24rpx; }
