.trip-page { display: flex; flex-direction: column; gap: 22rpx; }
.disclaimer, .budget-note { padding: 18rpx 20rpx; border-left: 6rpx solid var(--color-gold); background: #eee3cc; color: #6d604a; font-size: 23rpx; line-height: 1.7; }
.budget-note { margin-top: -12rpx; border-left-color: var(--color-primary); background: #e8eee4; color: #526656; }
.form-card, .current-plan, .confirmed-requirements, .adjustment-card { display: flex; flex-direction: column; gap: 16rpx; padding: 28rpx; }
.field { display: flex; flex-direction: column; gap: 12rpx; color: var(--color-text); font-size: 27rpx; }
.field input { height: 80rpx; padding: 0 20rpx; border: 1rpx solid var(--color-border); border-radius: 16rpx; background: #fffdf7; font-size: 27rpx; }
.preference-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.preference { min-height: 62rpx; margin: 0; padding: 0 18rpx; background: #f5eddf; color: var(--color-text); border: 1rpx solid var(--color-border); font-size: 23rpx; line-height: 62rpx; }
.preference.selected { background: #627968; border-color: #627968; color: #fff; }
.validation-errors { display: flex; flex-direction: column; gap: 6rpx; color: #914032; font-size: 24rpx; }
.waiting { padding: 18rpx 22rpx; color: var(--color-muted); font-size: 24rpx; }
.error-panel { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 20rpx; border: 1rpx solid #d99d90; border-radius: 20rpx; background: #fff2ed; color: #914032; font-size: 25rpx; }
.retry-button { flex-shrink: 0; min-height: 66rpx; padding: 10rpx 22rpx; color: var(--color-primary); font-size: 24rpx; }
.current-plan { border: 2rpx solid #627968; }
.current-plan-title, .confirmed-title { color: #3d5847; font-size: 29rpx; font-weight: 700; }
.confirmed-requirements { background: #f7f1e5; }
.confirmed-list { display: flex; flex-direction: column; gap: 10rpx; }
.confirmed-item, .confirmed-empty { color: #5d5548; font-size: 25rpx; line-height: 1.6; }
.adjustment-field { display: flex; flex-direction: column; gap: 12rpx; color: var(--color-text); font-size: 27rpx; }
.adjustment-field textarea { width: 100%; min-height: 144rpx; padding: 20rpx; border: 1rpx solid var(--color-border); border-radius: 16rpx; background: #fffdf7; font-size: 27rpx; line-height: 1.6; }
.adjustment-error { color: #914032; font-size: 24rpx; }
.adjustment-button, .submit-button { width: 100%; }
.adjustment-button { min-height: 80rpx; line-height: 1.4; }
.restart-button { color: var(--color-primary); font-size: 24rpx; }
