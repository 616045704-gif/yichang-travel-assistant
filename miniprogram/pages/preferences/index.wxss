.subtitle { color: var(--color-muted); font-size: 26rpx; line-height: 1.6; }.choices { display: flex; flex-wrap: wrap; gap: 18rpx; padding: 28rpx; background: var(--color-surface); }.choice { min-height: 72rpx; margin: 0; padding: 0 24rpx; border: 1rpx solid var(--color-border); border-radius: 999rpx; background: var(--color-page); color: var(--color-text); font-size: 26rpx; line-height: 72rpx; }.choice.selected { border-color: var(--color-brand); background: var(--color-brand); color: #fff; font-weight: 700; }.save-button { width: 100%; margin-top: 36rpx; }
