<view class="page">
  <view class="chapter-heading"><view><text class="eyebrow">PERSONAL SETTINGS</text><text class="page-title">旅行偏好</text></view></view>
  <view wx:if="{{status === 'ready'}}"><text class="subtitle">选择你在旅途中更在意的内容，最多 6 项。</text><view class="card choices"><button wx:for="{{options}}" wx:key="value" class="choice {{item.selected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="onToggle">{{item.value}}</button></view><button class="button-primary save-button" loading="{{saving}}" bindtap="onSave">保存偏好</button></view>
  <async-state wx:else status="{{status}}" title="旅行偏好暂不可用" message="{{message}}" bind:retry="onRetry" />
  <feedback-toast visible="{{feedback.visible}}" tone="{{feedback.tone}}" message="{{feedback.message}}" bind:dismiss="onFeedbackDismiss" />
</view>
