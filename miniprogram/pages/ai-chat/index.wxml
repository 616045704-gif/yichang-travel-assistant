<view class="page ai-page"><view class="chapter-heading"><view><text class="eyebrow">YICHANG AI GUIDE</text><text class="page-title">AI 旅游助手</text></view></view><text class="disclaimer">内容仅供出行参考，请以景区、交通等官方公告为准</text><button class="button-secondary new-chat-button" disabled="{{isSubmitting}}" bindtap="newChat">新对话</button><view class="message-list"><message-bubble wx:for="{{messages}}" wx:key="messageId" role="{{item.role}}" content="{{item.content}}" mode="{{item.mode}}" label="模拟回答，仅用于交互测试" /></view><source-card wx:if="{{result && result.status === 'succeeded'}}" facts="{{result.localFacts}}" references="{{result.references}}" /><view wx:if="{{isSubmitting}}" class="waiting"><text>正在生成回答，请稍候…</text></view><view wx:if="{{error}}" class="error-panel"><text>{{error}}</text><button class="button-secondary retry-button" bindtap="retry">重试</button></view><textarea class="question-input" value="{{input}}" maxlength="1000" placeholder="问问宜昌的景点、文化或出行安排" bindinput="onInput" /><view class="input-meta"><text>{{input.length}}/1000</text></view><button class="button-primary send-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="submit">发送</button></view>
