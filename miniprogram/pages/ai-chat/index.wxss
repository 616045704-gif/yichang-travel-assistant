.ai-page { display: flex; flex-direction: column; gap: 22rpx; min-height: 100vh; }.disclaimer { padding: 18rpx 20rpx; border-left: 6rpx solid var(--color-action); border-radius: 16rpx; background: var(--color-action-soft); color: var(--color-brand-deep); font-size: 23rpx; line-height: 1.7; }.new-chat-button { align-self: flex-end; min-height: 66rpx; padding: 10rpx 22rpx; border: 1rpx solid var(--color-brand); color: var(--color-brand); font-size: 24rpx; }.message-list { display: flex; flex-direction: column; gap: 18rpx; min-height: 250rpx; }.waiting { padding: 18rpx 22rpx; border-radius: 18rpx; background: var(--color-surface); color: var(--color-muted); font-size: 24rpx; }.error-panel { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 20rpx; border: 1rpx solid var(--color-danger); border-radius: 20rpx; background: var(--color-danger-soft); color: var(--color-danger); font-size: 25rpx; }.retry-button { flex-shrink: 0; min-height: 66rpx; padding: 10rpx 22rpx; border: 1rpx solid var(--color-brand); color: var(--color-brand); font-size: 24rpx; }.question-input { width: 100%; min-height: 180rpx; padding: 22rpx; border: 1rpx solid var(--color-border); border-radius: 24rpx; background: var(--color-surface); font-size: 28rpx; line-height: 1.7; }.input-meta { display: flex; align-items: center; justify-content: space-between; margin-top: -12rpx; color: var(--color-muted); font-size: 22rpx; }.send-button { width: 100%; }
