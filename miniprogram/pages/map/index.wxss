page { height: 100%; overflow: hidden; }
.page.map-page { position: relative; width: 100%; height: 100vh; padding: 0; overflow: hidden; }
.city-map { display: block; width: 100%; height: 100%; }
.map-filters { position: absolute; z-index: 2; top: 24rpx; left: 24rpx; right: 24rpx; padding: 0; border: 0; background: transparent; box-shadow: none; pointer-events: none; }
.map-actions { position: absolute; z-index: 2; right: 24rpx; bottom: 48rpx; display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.nearby-button, .settings-button, .detail-button { border: 0; border-radius: 999rpx; font-size: 26rpx; font-weight: 700; line-height: 1.9; }.nearby-button, .detail-button { background: var(--color-action); color: var(--color-brand-deep); }.settings-button { background: var(--color-brand-deep); color: #fff; }.map-notice { max-width: 460rpx; padding: 16rpx 20rpx; border: 1rpx solid var(--color-border); border-radius: 18rpx; background: rgba(255, 255, 255, .96); color: var(--color-text); font-size: 24rpx; box-shadow: var(--shadow-card); }.marker-card { position: absolute; z-index: 3; left: 24rpx; right: 24rpx; bottom: 48rpx; display: flex; flex-direction: column; gap: 10rpx; padding: 28rpx; border-radius: 28rpx; background: rgba(255, 255, 255, .98); box-shadow: 0 14rpx 36rpx rgba(43, 23, 77, .20); }.marker-category, .marker-distance { color: var(--color-brand); font-size: 24rpx; font-weight: 700; }.marker-name { color: var(--color-brand-deep); font-size: 34rpx; font-weight: 700; }.detail-button { align-self: flex-end; min-width: 180rpx; }
