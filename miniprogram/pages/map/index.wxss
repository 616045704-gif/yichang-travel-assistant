page { height: 100%; overflow: hidden; }
.page.map-page { position: relative; width: 100%; height: 100vh; padding: 0; overflow: hidden; }
.city-map { display: block; width: 100%; height: 100%; }
.map-filters { position: absolute; z-index: 2; top: 24rpx; left: 20rpx; right: 20rpx; padding: 12rpx; border: 1rpx solid rgba(116, 84, 216, .10); border-radius: 30rpx; background: rgba(255, 255, 255, .95); box-shadow: 0 12rpx 30rpx rgba(53, 39, 92, .10); pointer-events: auto; }
.map-filter-track { display: flex; align-items: stretch; width: 100%; min-width: 0; gap: 8rpx; }
.map-filter-tab { display: flex; box-sizing: border-box; flex: 1 1 0; flex-direction: column; align-items: center; justify-content: center; min-width: 0; width: auto; height: 112rpx; margin: 0; padding: 8rpx 4rpx 7rpx; border: 1rpx solid rgba(116, 84, 216, .10); border-radius: 24rpx; background: rgba(255, 255, 255, .98); box-shadow: 0 8rpx 22rpx rgba(53, 39, 92, .06); line-height: normal; }
.map-filter-tab.is-active { border-color: #d9ceff; background: #f0ecff; box-shadow: 0 8rpx 24rpx rgba(116, 84, 216, .10); }
.map-filter-icon { display: block; width: 56rpx; height: 56rpx; }
.map-filter-label { max-width: 100%; margin-top: 0; color: var(--color-text-strong); font-size: 20rpx; font-weight: 700; line-height: 1; text-align: center; white-space: normal; }
.map-filter-tab.is-active .map-filter-label { color: var(--color-brand); }
.map-bottom-stack { position: absolute; z-index: 3; left: 24rpx; right: 24rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: stretch; gap: 16rpx; }
.map-actions { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.region-button, .detail-button { display: flex; box-sizing: border-box; align-items: center; justify-content: center; height: 72rpx; min-height: 72rpx; margin: 0; padding: 0 24rpx; border-radius: 999rpx; font-size: 25rpx; font-weight: 700; line-height: 1; }
.region-button { border: 1rpx solid var(--color-border); background: rgba(255, 255, 255, .97); color: var(--color-brand); box-shadow: 0 8rpx 22rpx rgba(53, 39, 92, .08); }
.detail-button { border: 0; background: var(--color-brand); color: #fff; }
.map-notice { max-width: 460rpx; padding: 16rpx 20rpx; border: 1rpx solid var(--color-border); border-radius: 18rpx; background: rgba(255, 255, 255, .97); color: var(--color-text); font-size: 24rpx; box-shadow: 0 8rpx 22rpx rgba(53, 39, 92, .08); }
.marker-card { display: flex; box-sizing: border-box; align-items: center; gap: 24rpx; min-height: 280rpx; padding: 28rpx 24rpx; border: 1rpx solid rgba(90, 70, 138, .12); border-radius: 30rpx; background: rgba(255, 255, 255, .98); box-shadow: 0 16rpx 38rpx rgba(53, 39, 92, .14); }
.marker-cover { flex: 0 0 224rpx; width: 224rpx; height: 224rpx; border-radius: 24rpx; background: #e9edf2; }
.marker-copy { display: flex; flex: 1; flex-direction: column; align-items: stretch; min-width: 0; min-height: 224rpx; justify-content: space-between; padding: 0; }
.marker-category-row { display: flex; align-items: center; gap: 8rpx; align-self: flex-start; max-width: 100%; padding: 4rpx 12rpx 4rpx 6rpx; border-radius: 999rpx; background: #f0ecff; }
.marker-category-icon { flex: 0 0 auto; width: 40rpx; height: 40rpx; }
.marker-category { overflow: hidden; color: var(--color-brand); font-size: 21rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.marker-name { display: -webkit-box; max-width: 100%; margin: 12rpx 0; overflow: hidden; color: var(--color-text-strong); font-size: 34rpx; font-weight: 750; line-height: 1.3; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.detail-button { width: 100%; align-self: stretch; min-width: 0; padding: 0 22rpx; }
.detail-button.detail-button-pressed { opacity: .82; }
