page { height: 100%; overflow: hidden; }
.page.map-page { position: relative; width: 100%; height: 100vh; padding: 0; overflow: hidden; }
.city-map { display: block; width: 100%; height: 100%; }
.map-filters { position: absolute; z-index: 2; top: 24rpx; left: 24rpx; width: 250rpx; padding: 0; border: 0; background: transparent; box-shadow: none; pointer-events: auto; }
.map-bottom-stack { position: absolute; z-index: 3; left: 24rpx; right: 24rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: stretch; gap: 16rpx; }
.map-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.nearby-button, .settings-button, .detail-button { min-height: 72rpx; padding: 0 24rpx; border-radius: 999rpx; font-size: 25rpx; font-weight: 700; line-height: 1.5; }.nearby-button, .settings-button { border: 1rpx solid var(--color-border); background: rgba(255, 255, 255, .97); color: var(--color-brand); box-shadow: 0 8rpx 22rpx rgba(53, 39, 92, .08); }.detail-button { border: 0; background: var(--color-brand); color: #fff; }.map-notice { max-width: 460rpx; padding: 16rpx 20rpx; border: 1rpx solid var(--color-border); border-radius: 18rpx; background: rgba(255, 255, 255, .97); color: var(--color-text); font-size: 24rpx; box-shadow: 0 8rpx 22rpx rgba(53, 39, 92, .08); }.marker-card { display: flex; align-items: stretch; gap: 20rpx; padding: 18rpx; border: 1rpx solid rgba(90, 70, 138, .12); border-radius: 26rpx; background: rgba(255, 255, 255, .98); box-shadow: 0 16rpx 38rpx rgba(53, 39, 92, .14); }.marker-cover { flex: 0 0 176rpx; width: 176rpx; height: 144rpx; border-radius: 18rpx; background: #e9edf2; }.marker-copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; min-width: 0; padding: 4rpx 2rpx 2rpx 0; }.marker-category { color: var(--color-brand); font-size: 22rpx; font-weight: 700; }.marker-name { display: block; max-width: 100%; margin-top: 7rpx; overflow: hidden; color: var(--color-text-strong); font-size: 31rpx; font-weight: 750; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }.detail-button { align-self: flex-end; min-width: 150rpx; min-height: 52rpx; margin-top: auto; padding: 0 20rpx; font-size: 22rpx; }
