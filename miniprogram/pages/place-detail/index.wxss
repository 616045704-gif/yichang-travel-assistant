.detail-page { padding: 0 0 56rpx; }.hero-image, .cover-fallback { width: 100%; height: 440rpx; }.cover-fallback { display: flex; align-items: center; justify-content: center; background: var(--color-page); color: var(--color-muted); }.detail-card { display: flex; flex-direction: column; gap: 16rpx; margin: 24rpx; padding: 28rpx; }.detail-title { color: var(--color-brand-deep); font-size: 46rpx; font-weight: 700; line-height: 1.18; }.label { margin-top: 8rpx; color: var(--color-brand); font-size: 24rpx; font-weight: 700; }.section-text, .source { line-height: 1.75; }.section-image { width: 100%; border-radius: 20rpx; }.tags { display: flex; flex-wrap: wrap; gap: 12rpx; }.title-row { display: flex; justify-content: space-between; gap: 20rpx; }.title-row > view { min-width: 0; }.favorite-button { display: inline-flex; align-items: center; justify-content: center; gap: 8rpx; flex: 0 0 auto; width: 136rpx; min-width: 136rpx; height: 72rpx; margin: 0; padding: 0; white-space: nowrap; border-radius: 36rpx; background: var(--color-action); color: var(--color-brand-deep); font-size: 24rpx; font-weight: 700; line-height: 72rpx; }.favorite-button .favorite-icon { position: relative; box-sizing: border-box; width: 18rpx; height: 24rpx; border: 3rpx solid currentColor; border-radius: 4rpx 4rpx 0 0; }.favorite-button .favorite-icon::after { position: absolute; bottom: -7rpx; left: 2rpx; width: 9rpx; height: 9rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; background: var(--color-action); content: ''; transform: rotate(45deg); }.favorite-button .favorite-icon.is-active { background: currentColor; }.favorite-button::after { border: 0; }
