.detail-page { padding-bottom: 48rpx; background: var(--color-page); }.hero-image, .cover-fallback { width: 100%; height: 420rpx; }.cover-fallback { display: flex; align-items: center; justify-content: center; background: #e8dfcf; color: var(--color-muted); }.detail-card { box-sizing: border-box; display: flex; width: 100%; flex-direction: column; gap: 16rpx; margin: 24rpx 0 0; padding: 32rpx; border: 1rpx solid var(--color-border); border-right: 0; border-left: 0; border-radius: 0; background: var(--color-surface); box-shadow: none; }.detail-overview { margin-top: 0; }.detail-section-heading { display: flex; align-items: center; justify-content: flex-start; gap: 14rpx; min-height: 48rpx; margin: 0; }.section-marker { position: relative; display: block; width: 36rpx; height: 36rpx; flex: 0 0 36rpx; overflow: hidden; border-radius: 12rpx; }.section-marker::after { position: absolute; top: 11rpx; left: 9rpx; width: 18rpx; height: 14rpx; border-radius: 7rpx 7rpx 5rpx 5rpx; background: rgba(255, 255, 255, .94); content: ''; }.section-marker.primary { background: var(--color-brand); }.section-marker.info { background: #f6c644; }.section-marker.story { background: #54b5bd; }.section-marker.source { background: #8d73df; }.detail-title { min-width: 0; font-family: var(--font-display); color: var(--color-ink); font-size: 52rpx; font-weight: 800; line-height: 1.18; }.card-headline { color: var(--color-ink); font-size: 36rpx; font-weight: 800; line-height: 1.35; }.label { margin-top: 8rpx; color: var(--color-gold-dark); font-size: 26rpx; font-weight: 700; }.section-text, .source { line-height: 1.8; }.section-image { width: 100%; border-radius: 16rpx; }.tags { display: flex; flex-wrap: wrap; gap: 12rpx; }.title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }.place-title-wrap { min-width: 0; }.favorite-button { display: inline-flex; align-items: center; justify-content: center; gap: 8rpx; flex: 0 0 auto; width: 160rpx; min-width: 160rpx; height: 80rpx; margin: 0; padding: 0; white-space: nowrap; border-radius: 40rpx; background: var(--color-action); color: var(--color-brand-deep); font-size: 25rpx; font-weight: 700; line-height: 80rpx; }.detail-favorite-image { width: 36rpx; height: 36rpx; }.favorite-button::after { border: 0; }
