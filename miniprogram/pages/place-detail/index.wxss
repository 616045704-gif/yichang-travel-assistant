.detail-page { padding-bottom: 48rpx; }.hero-image, .cover-fallback { width: 100%; height: 420rpx; }.cover-fallback { display: flex; align-items: center; justify-content: center; background: #e8dfcf; color: var(--color-muted); }.detail-card { display: flex; flex-direction: column; gap: 16rpx; margin: 24rpx; padding: 28rpx; }.detail-title { font-family: var(--font-display); font-size: 46rpx; color: var(--color-ink); }.label { margin-top: 8rpx; color: var(--color-gold-dark); font-size: 24rpx; }.section-text, .source { line-height: 1.8; }.section-image { width: 100%; border-radius: 16rpx; }.tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.title-row { display: flex; justify-content: space-between; gap: 20rpx; }.title-row > view { min-width: 0; }.favorite-button { display: inline-flex; align-items: center; justify-content: center; gap: 8rpx; flex: 0 0 auto; width: 136rpx; min-width: 136rpx; height: 72rpx; margin: 0; padding: 0; white-space: nowrap; border-radius: 36rpx; background: #627968; color: #fff; font-size: 24rpx; line-height: 72rpx; }.favorite-button .favorite-icon { font-size: 30rpx; line-height: 1; }.favorite-button::after { border: 0; }
