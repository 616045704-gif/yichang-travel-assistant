.detail-page { padding: 0 0 56rpx; background: var(--color-surface); }.hero-image, .cover-fallback { width: 100%; height: 460rpx; }.cover-fallback { display: flex; align-items: center; justify-content: center; background: var(--color-page); color: var(--color-muted); }.detail-card { display: flex; flex-direction: column; gap: 16rpx; margin: 0 32rpx; padding: 32rpx 0; border: 0; border-bottom: 1rpx solid var(--color-border); border-radius: 0; box-shadow: none; }.detail-title { color: var(--color-text-strong); font-size: 48rpx; font-weight: 800; letter-spacing: -1.5rpx; line-height: 1.18; }.label { margin-top: 12rpx; color: var(--color-brand); font-size: 23rpx; font-weight: 700; }.section-text, .source { line-height: 1.75; }.section-image { width: 100%; border-radius: 18rpx; }.tags { display: flex; flex-wrap: wrap; gap: 10rpx; }.title-row { display: flex; justify-content: space-between; gap: 20rpx; }.title-row > view { min-width: 0; }.favorite-button { display: grid; flex: 0 0 auto; width: 64rpx; min-width: 64rpx; height: 64rpx; padding: 0; border: 1rpx solid var(--color-border); border-radius: 50%; background: var(--color-surface); color: var(--color-brand); place-items: center; }.favorite-button text { display: none; }.detail-favorite-image { width: 38rpx; height: 38rpx; }.favorite-button::after { border: 0; }
