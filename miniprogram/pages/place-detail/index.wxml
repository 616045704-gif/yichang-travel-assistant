<view class="page detail-page">
  <block wx:if="{{status === 'ready' && place}}"><image wx:if="{{place.coverUrl}}" class="hero-image" src="{{place.coverUrl}}" mode="aspectFill" /><view class="cover-fallback" wx:else>图片暂不可用</view><view class="detail-card card"><text class="eyebrow">{{place.district}} · {{place.category}}</text><text class="detail-title">{{place.name}}</text><text class="intro">{{place.intro}}</text><view class="tags"><text wx:for="{{place.tags}}" wx:key="*this" class="tag">{{item}}</text></view></view><view class="detail-card card"><text class="label">地址</text><text>{{place.address}}</text><text wx:if="{{place.openNotice}}" class="label">开放提示</text><text wx:if="{{place.openNotice}}">{{place.openNotice}}</text><text wx:if="{{place.visitAdvice}}" class="label">游玩建议</text><text wx:if="{{place.visitAdvice}}">{{place.visitAdvice}}</text><text wx:if="{{place.diningInfo}}" class="label">餐饮信息</text><text wx:if="{{place.diningInfo}}">{{place.diningInfo}}</text></view><view class="detail-card card"><text class="label">图文介绍</text><block wx:for="{{place.sections}}" wx:key="index"><text wx:if="{{item.type === 'text'}}" class="section-text">{{item.text}}</text><image wx:if="{{item.type === 'image' && item.url}}" class="section-image" src="{{item.url}}" mode="widthFix" /></block></view><view class="detail-card card"><text class="label">资料来源与核验</text><text wx:for="{{place.sources}}" wx:key="title" class="source">{{item.title}} · {{item.verifiedAt || place.verifiedAt}}</text></view></block>
  <async-state wx:else status="{{status}}" title="地点详情暂不可用" message="{{message}}" bind:retry="onRetry" />
</view>
