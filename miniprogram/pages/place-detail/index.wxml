<view class="page detail-page">
  <block wx:if="{{status === 'ready' && place}}">
    <image wx:if="{{place.coverUrl}}" class="hero-image" src="{{place.coverUrl}}" mode="aspectFill" />
    <view class="cover-fallback" wx:else>图片暂不可用</view>
    <view class="detail-card detail-overview card">
      <view class="favorite-anchor {{favoritePending ? 'is-pending' : ''}}" bindtap="onFavorite" aria-role="button" aria-disabled="{{favoritePending}}" aria-label="{{place.isFavorite ? '取消收藏' : '收藏地点'}}"><image class="detail-favorite-image" src="{{place.isFavorite ? '/assets/provided/favorite-active.png' : '/assets/provided/favorite.png'}}" mode="aspectFit" /></view><view class="title-row"><text class="eyebrow">{{place.district}} · {{place.category}}</text></view><view class="detail-section-heading place-name-heading"><view class="section-marker primary" aria-hidden="true"></view><text class="detail-title">{{place.name}}</text></view>
      <text class="intro">{{place.intro}}</text><view class="tags"><text wx:for="{{place.tags}}" wx:key="*this" class="tag">{{item}}</text></view>
    </view>
    <view class="detail-card card"><view class="detail-section-heading"><view class="section-marker info" aria-hidden="true"></view><text class="card-headline">出行信息</text></view><text class="label">地址</text><text>{{place.address}}</text><text wx:if="{{place.openNotice}}" class="label">开放提示</text><text wx:if="{{place.openNotice}}">{{place.openNotice}}</text><text wx:if="{{place.visitAdvice}}" class="label">游玩建议</text><text wx:if="{{place.visitAdvice}}">{{place.visitAdvice}}</text><text wx:if="{{place.diningInfo}}" class="label">餐饮信息</text><text wx:if="{{place.diningInfo}}">{{place.diningInfo}}</text></view>
    <view class="detail-card card"><view class="detail-section-heading"><view class="section-marker story" aria-hidden="true"></view><text class="card-headline">图文介绍</text></view><block wx:for="{{place.sections}}" wx:key="index"><text wx:if="{{item.type === 'text'}}" class="section-text">{{item.text}}</text><image wx:if="{{item.type === 'image' && item.url}}" class="section-image" src="{{item.url}}" mode="widthFix" /></block></view>
    <view class="detail-card card"><view class="detail-section-heading"><view class="section-marker source" aria-hidden="true"></view><text class="card-headline">资料说明</text></view><text wx:for="{{place.sources}}" wx:key="title" class="source">{{item.kind === 'local_reference' ? '本地整理参考 · ' : '本地已核验资料 · '}}{{item.title}} · {{item.verifiedAt || place.verifiedAt}}</text><text wx:if="{{place.sources.length}}" class="source">价格、营业时间、交通和预约请以官方公告为准。</text></view>
  </block>
  <async-state wx:else status="{{status}}" title="地点详情暂不可用" message="{{message}}" bind:retry="onRetry" />
</view><feedback-toast visible="{{feedback.visible}}" tone="{{feedback.tone}}" message="{{feedback.message}}" bind:dismiss="onFeedbackDismiss" />
