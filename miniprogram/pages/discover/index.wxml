<view class="page discover-page">
  <view class="discover-hero">
    <image class="discover-hero-image" src="/assets/provided/discover-hero.jpg" mode="aspectFill" />
    <view class="discover-hero-shade"></view>
    <view class="discover-hero-copy"><text class="discover-hero-title">发现宜昌</text><text class="discover-hero-note">把下一次出发，放进今天。</text></view>
  </view>
  <view class="discover-tools">
    <view class="discover-category"><category-filter id="categories" value="{{category}}" bind:categorychange="onCategoryChange" /></view>
    <view class="search-panel"><input class="search-input" value="{{keyword}}" placeholder="搜索地点名称或简介" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onSearch" /><button size="mini" class="search-icon" bindtap="onSearch" aria-label="确认搜索"><view class="search-glyph"></view></button></view>
  </view>
  <view class="section-heading"><text class="section-title">地点清单</text><text class="badge">云端资料</text></view>
  <view wx:if="{{status === 'ready'}}" class="place-list"><place-card wx:for="{{items}}" wx:key="placeId" place="{{item}}" bind:open="openPlace" bind:favoritechange="onFavorite" /></view>
  <view wx:if="{{status !== 'ready'}}" class="card"><async-state id="content-state" status="{{status}}" title="{{status === 'empty' ? '暂未找到地点' : '地点资料加载失败'}}" message="{{status === 'empty' ? '试试切换分类或调整搜索条件。' : message}}" bind:retry="onRetry" /></view>
  <view class="discovery-note"><text class="discovery-note-title">资料持续更新</text><text class="note">地点内容附有来源与核验日期，出发前请以官方公告为准。</text></view><feedback-toast visible="{{feedback.visible}}" tone="{{feedback.tone}}" message="{{feedback.message}}" bind:dismiss="onFeedbackDismiss" />
</view>
