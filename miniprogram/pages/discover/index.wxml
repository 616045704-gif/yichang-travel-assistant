<view class="page">
  <view class="chapter-heading"><view><text class="eyebrow">YICHANG DISCOVERY</text><text class="page-title">发现好地方</text></view></view><text class="subtitle">山水、人文与烟火，都值得停留。</text>
  <view class="filter-wrap"><category-filter id="categories" value="{{category}}" bind:categorychange="onCategoryChange" /></view>
  <view class="search-panel card"><input value="{{keyword}}" placeholder="搜索地点名称或简介" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onSearch" /><button size="mini" class="search-icon" bindtap="onSearch" aria-label="确认搜索"><view class="search-glyph"></view></button></view>
  <view class="section-heading"><text class="section-title">地点清单</text><text class="badge">云端资料</text></view>
  <view wx:if="{{status === 'ready'}}" class="place-list"><place-card wx:for="{{items}}" wx:key="placeId" place="{{item}}" bind:open="openPlace" bind:favoritechange="onFavorite" /></view>
  <view class="card"><async-state id="content-state" status="{{status}}" title="{{status === 'empty' ? '暂未找到地点' : '地点资料加载失败'}}" message="{{status === 'empty' ? '试试切换分类或调整搜索条件。' : message}}" bind:retry="onRetry" /></view>
  <view class="discovery-note"><text class="discovery-note-title">让每一次出发，都有据可查</text><text class="note">地点上线后将附资料来源与核验日期，帮助你安排自己的旅程。</text></view><feedback-toast visible="{{feedback.visible}}" tone="{{feedback.tone}}" message="{{feedback.message}}" bind:dismiss="onFeedbackDismiss" />
</view>
