.filter-wrap { margin-top: 30rpx; }
.search-panel { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; padding: 0; border: 0; border-bottom: 2rpx solid var(--color-border); border-radius: 0; background: transparent; }
.search-panel input { flex: 1; min-width: 0; height: 84rpx; padding: 0; border: 0; background: transparent; color: var(--color-text); font-size: 26rpx; }
.search-icon { flex: 0 0 66rpx; width: 66rpx; min-width: 66rpx; height: 66rpx; margin: 0; padding: 0; border-radius: 50%; background: var(--color-action-soft); }.search-icon::after { border: 0; }
.search-glyph { position: relative; box-sizing: border-box; width: 22rpx; height: 22rpx; margin: 17rpx auto 0; border: 3rpx solid var(--color-brand); border-radius: 50%; }.search-glyph::after { position: absolute; right: -9rpx; bottom: -6rpx; width: 11rpx; height: 3rpx; border-radius: 3rpx; background: var(--color-brand); content: ''; transform: rotate(45deg); }
.place-list { border-top: 1rpx solid var(--color-border); }.discovery-note { margin-top: 34rpx; padding: 24rpx 0; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); background: transparent; }.discovery-note-title { display: block; margin-bottom: 8rpx; color: var(--color-brand); font-size: 26rpx; font-weight: 700; }
