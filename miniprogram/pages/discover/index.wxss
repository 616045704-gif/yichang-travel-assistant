.discover-page { padding-top: 24rpx; background: var(--color-surface); }
.discover-hero { position: relative; height: 340rpx; overflow: hidden; border-radius: 28rpx; background: #54b4df; }
.discover-hero-image { width: 100%; height: 100%; }
.discover-hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20, 34, 50, .68), rgba(20, 34, 50, .12) 70%); }
.discover-hero-copy { position: absolute; top: 46rpx; left: 30rpx; color: #fff; }
.discover-hero-title, .discover-hero-note { display: block; }
.discover-hero-title { font-size: 46rpx; font-weight: 800; letter-spacing: -1.4rpx; line-height: 1.2; }
.discover-hero-note { max-width: 310rpx; margin-top: 10rpx; color: rgba(255, 255, 255, .9); font-size: 24rpx; line-height: 1.55; }
.discover-tools { display: flex; align-items: stretch; gap: 14rpx; margin-top: 24rpx; }
.discover-category { flex: 0 0 214rpx; width: 214rpx; min-width: 0; }
.search-panel { display: flex; flex: 1; align-items: center; gap: 8rpx; min-width: 0; height: 80rpx; padding: 0 10rpx 0 18rpx; border: 1rpx solid var(--color-border); border-radius: 20rpx; background: var(--color-surface); box-shadow: 0 8rpx 22rpx rgba(53, 39, 92, .05); }
.search-input { flex: 1; min-width: 0; height: 80rpx; padding: 0; border: 0; background: transparent; color: var(--color-text); font-size: 25rpx; }
.search-icon { flex: 0 0 62rpx; width: 62rpx; min-width: 62rpx; height: 62rpx; margin: 0; padding: 0; border-radius: 16rpx; background: var(--color-action-soft); }.search-icon::after { border: 0; }
.search-glyph { position: relative; box-sizing: border-box; width: 22rpx; height: 22rpx; margin: 17rpx auto 0; border: 3rpx solid var(--color-brand); border-radius: 50%; }.search-glyph::after { position: absolute; right: -9rpx; bottom: -6rpx; width: 11rpx; height: 3rpx; border-radius: 3rpx; background: var(--color-brand); content: ''; transform: rotate(45deg); }
.place-list { border-top: 1rpx solid var(--color-border); }.discovery-note { margin-top: 34rpx; padding: 24rpx 0; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); background: transparent; }.discovery-note-title { display: block; margin-bottom: 8rpx; color: var(--color-brand); font-size: 26rpx; font-weight: 700; }
