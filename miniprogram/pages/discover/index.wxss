.discover-page { padding-top: 24rpx; background: var(--color-surface); }
.discover-hero { position: relative; height: 340rpx; overflow: hidden; border-radius: 28rpx; background: #54b4df; }
.discover-hero-image { width: 100%; height: 100%; }
.discover-hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20, 34, 50, .68), rgba(20, 34, 50, .12) 70%); }
.discover-hero-copy { position: absolute; top: 46rpx; left: 30rpx; color: #fff; }
.discover-hero-title, .discover-hero-note { display: block; }
.discover-hero-title { font-size: 46rpx; font-weight: 800; letter-spacing: -1.4rpx; line-height: 1.2; }
.discover-hero-note { max-width: 310rpx; margin-top: 10rpx; color: rgba(255, 255, 255, .9); font-size: 24rpx; line-height: 1.55; }
.discover-tools { display: flex; flex-wrap: nowrap; align-items: stretch; gap: 14rpx; margin-top: 24rpx; overflow: hidden; }
.discover-search { flex: 0 0 88rpx; min-width: 0; height: 112rpx; transition: flex-basis .2s ease; }
.discover-search.is-expanded { flex-basis: 324rpx; }
.discover-category { flex: 1; min-width: 300rpx; overflow: hidden; }
.search-trigger-shell, .search-panel { box-sizing: border-box; width: 100%; height: 112rpx; border: 1rpx solid rgba(116, 84, 216, .12); border-radius: 24rpx; background: rgba(255, 255, 255, .98); box-shadow: 0 8rpx 22rpx rgba(53, 39, 92, .06); }
.search-trigger-shell { position: relative; display: flex; align-items: center; justify-content: center; min-width: 88rpx; border-color: #d9ceff; background: #fff; }
.search-line-icon { position: relative; width: 28rpx; height: 28rpx; border: 3rpx solid #4d4858; border-radius: 50%; pointer-events: none; }
.search-line-icon::after { position: absolute; right: -11rpx; bottom: -7rpx; width: 14rpx; height: 3rpx; border-radius: 999rpx; background: #4d4858; content: ''; transform: rotate(45deg); transform-origin: center; }
.search-trigger { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; background: transparent; }
.search-trigger::after, .search-close::after, .search-send::after { border: 0; }
.search-panel { display: flex; align-items: center; gap: 8rpx; min-width: 0; padding: 0 10rpx; }
.search-close-shell, .search-send-shell { position: relative; display: flex; flex: 0 0 auto; align-items: center; justify-content: center; height: 80rpx; border-radius: 50%; }
.search-close-shell { width: 80rpx; }
.search-send-shell { width: 80rpx; }
.search-close, .search-send { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; line-height: 1; }
.search-trigger.search-control-pressed, .search-close.search-control-pressed, .search-send.search-control-pressed { background: rgba(116, 84, 216, .09); }
.close-glyph { position: relative; width: 26rpx; height: 26rpx; pointer-events: none; }
.close-glyph::before, .close-glyph::after { position: absolute; top: 12rpx; left: 1rpx; width: 24rpx; height: 3rpx; border-radius: 999rpx; background: #726a80; content: ''; }
.close-glyph::before { transform: rotate(45deg); }
.close-glyph::after { transform: rotate(-45deg); }
.search-input { flex: 1; min-width: 0; height: 92rpx; padding: 0; border: 0; background: transparent; color: var(--color-text); font-size: 24rpx; }
.send-glyph { position: relative; width: 30rpx; height: 30rpx; pointer-events: none; transform: rotate(-7deg); }
.send-glyph::before { position: absolute; top: 3rpx; left: 2rpx; width: 0; height: 0; border-top: 12rpx solid transparent; border-bottom: 12rpx solid transparent; border-left: 28rpx solid var(--color-brand); content: ''; }
.send-glyph::after { position: absolute; top: 13rpx; left: 4rpx; width: 17rpx; height: 4rpx; background: #fff; content: ''; transform: rotate(-10deg); transform-origin: left center; }
.place-list { border-top: 1rpx solid var(--color-border); }.discovery-note { margin-top: 34rpx; padding: 24rpx 0; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); background: transparent; }.discovery-note-title { display: block; margin-bottom: 8rpx; color: var(--color-brand); font-size: 26rpx; font-weight: 700; }
