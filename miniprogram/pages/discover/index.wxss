.filter-wrap { margin-top: 24rpx; }.search-panel { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; padding: 16rpx; }.search-panel input { flex: 1; min-width: 0; height: 64rpx; padding: 0 18rpx; border: 1rpx solid var(--color-line); border-radius: 32rpx; background: #fffdf8; font-size: 26rpx; }.search-icon { flex: 0 0 64rpx; width: 64rpx; min-width: 64rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 50%; background: var(--color-ink); }.search-icon::after { border: 0; }.search-glyph { position: relative; box-sizing: border-box; width: 24rpx; height: 24rpx; margin: 16rpx auto 0; border: 4rpx solid #fff; border-radius: 50%; }.search-glyph::after { content: ''; position: absolute; right: -10rpx; bottom: -6rpx; width: 12rpx; height: 4rpx; border-radius: 4rpx; background: #fff; transform: rotate(45deg); }.place-list { display: grid; gap: 20rpx; }.discovery-note { margin-top: 30rpx; padding: 28rpx; border-left: 4rpx solid var(--color-gold); background: linear-gradient(90deg, #efe4cf, transparent); }.discovery-note-title { display: block; font-family: var(--font-display); font-size: 28rpx; margin-bottom: 10rpx; }
