.filter-wrap { margin-top: 24rpx; }.search-panel { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; padding: 16rpx; }.search-panel input { flex: 1; min-width: 0; height: 64rpx; padding: 0 18rpx; border: 1rpx solid var(--color-line); border-radius: 32rpx; background: #fffdf8; font-size: 26rpx; }.search-icon { flex: 0 0 64rpx; width: 64rpx; min-width: 64rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 50%; color: #fff; background: var(--color-ink); font-size: 28rpx; line-height: 64rpx; }.search-icon::after { border: 0; }.place-list { display: grid; gap: 20rpx; }.discovery-note { margin-top: 30rpx; padding: 28rpx; border-left: 4rpx solid var(--color-gold); background: linear-gradient(90deg, #efe4cf, transparent); }.discovery-note-title { display: block; font-family: var(--font-display); font-size: 28rpx; margin-bottom: 10rpx; }
