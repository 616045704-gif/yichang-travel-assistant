.filter-wrap { margin-top: 28rpx; }.search-panel { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; padding: 12rpx; }.search-panel input { flex: 1; min-width: 0; height: 72rpx; padding: 0 20rpx; border: 1rpx solid var(--color-border); border-radius: 20rpx; background: var(--color-page); color: var(--color-text); font-size: 26rpx; }.search-icon { flex: 0 0 72rpx; width: 72rpx; min-width: 72rpx; height: 72rpx; margin: 0; padding: 0; border-radius: 20rpx; background: var(--color-action); }.search-icon::after { border: 0; }.search-glyph { position: relative; box-sizing: border-box; width: 24rpx; height: 24rpx; margin: 17rpx auto 0; border: 4rpx solid var(--color-brand-deep); border-radius: 50%; }.search-glyph::after { position: absolute; right: -10rpx; bottom: -6rpx; width: 12rpx; height: 4rpx; border-radius: 4rpx; background: var(--color-brand-deep); content: ''; transform: rotate(45deg); }.place-list { display: grid; gap: 20rpx; }.discovery-note { margin-top: 30rpx; padding: 28rpx; border-radius: var(--radius-card); background: var(--color-brand-deep); }.discovery-note-title { display: block; margin-bottom: 10rpx; color: var(--color-action); font-size: 28rpx; font-weight: 700; }.discovery-note .note { color: #e1d9fc; }
