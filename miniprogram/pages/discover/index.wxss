.filter-wrap { margin-top: 24rpx; }.search-panel { display: grid; grid-template-columns: 1fr auto; gap: 16rpx; margin-top: 20rpx; padding: 24rpx; }.search-panel input { min-width: 0; padding: 14rpx 16rpx; border: 1rpx solid var(--color-line); border-radius: 12rpx; background: #fffdf8; font-size: 26rpx; }.search-panel button { grid-row: span 2; align-self: stretch; color: #fff; background: var(--color-ink); }.place-list { display: grid; gap: 20rpx; }.discovery-note { margin-top: 30rpx; padding: 28rpx; border-left: 4rpx solid var(--color-gold); background: linear-gradient(90deg, #efe4cf, transparent); }.discovery-note-title { display: block; font-family: var(--font-display); font-size: 28rpx; margin-bottom: 10rpx; }
