@import "styles/tokens.wxss";

page { background: var(--color-background); color: var(--color-text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 28rpx; line-height: 1.6; }
view, button, text { box-sizing: border-box; }
button { margin: 0; font: inherit; border-radius: var(--radius-control); }
button::after { border: 0; }
button[disabled] { background: #e9ece5; color: #7c887e; }
.page { padding: 28rpx var(--space-page) 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.eyebrow { display: block; font-size: 20rpx; letter-spacing: 5rpx; color: var(--color-muted); }
.page-title { display: block; font-size: 48rpx; font-weight: 650; letter-spacing: 2rpx; margin: 10rpx 0; }
.subtitle { display: block; color: var(--color-muted); font-size: 25rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 42rpx 0 20rpx; }
.section-title { font-size: 32rpx; font-weight: 600; }
.section-note { font-size: 23rpx; color: var(--color-muted); }
.card { background: var(--color-surface); border: 1rpx solid var(--color-border); border-radius: var(--radius-card); overflow: hidden; }
.button-primary { min-height: 88rpx; padding: 22rpx 30rpx; line-height: 1.5; background: var(--color-primary); color: #fffefa; font-weight: 600; }
.button-secondary { min-height: 88rpx; padding: 22rpx 30rpx; line-height: 1.5; background: #e7eee5; color: var(--color-primary); }
.note { color: var(--color-muted); font-size: 23rpx; line-height: 1.8; overflow-wrap: break-word; }
.badge { display: inline-block; padding: 6rpx 16rpx; border-radius: 20rpx; background: var(--color-gold-light); color: #886b3d; font-size: 21rpx; }
.footer-note { margin-top: 36rpx; text-align: center; font-size: 21rpx; letter-spacing: 2rpx; color: var(--color-muted); }
