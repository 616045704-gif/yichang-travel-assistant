page {
  --color-brand: #7454d8;
  --color-brand-deep: #29243a;
  --color-action: #7454d8;
  --color-action-soft: #f0ecff;
  --color-page: #f8f7fb;
  --color-surface: #ffffff;
  --color-text: #29243a;
  --color-text-strong: #1f1a2c;
  --color-muted: #817a91;
  --color-border: #eae6f1;
  --color-brand-soft: #f0ecff;
  --color-danger: #c63d55;
  --color-danger-soft: #fff0f2;
  --color-success: #2f8a70;
  --color-warning: #f6c644;
  --font-sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  --radius-card: 24rpx;
  --radius-control: 18rpx;
  --space-page: 32rpx;
  --shadow-card: none;

  /* Compatibility aliases keep existing page selectors visual-only while they share this system. */
  --color-primary: var(--color-brand);
  --color-deep: var(--color-brand-deep);
  --color-accent: var(--color-brand);
  --color-gold: var(--color-warning);
  --color-gold-light: #fff9e5;
  --color-background: var(--color-page);
  --color-ink: var(--color-text);
  --color-line: var(--color-border);
  --color-gold-dark: var(--color-brand-deep);
}
